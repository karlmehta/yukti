#!/usr/bin/env python3
# A stand-in for appium-uiautomator2-server, so tests/run.sh can drive the
# engine's screen helper with no device. tests/run.sh starts one per case on a
# free local port and writes the port to $1/server-port; the fake adb forwards
# to it. State lives in files in $1, shared with the fake adb:
#
#   running        present: the helper is up. Absent: every connection is
#                  closed unanswered - what a forward to a dead helper gives
#   session        the one open session; POST /session replaces it
#   settings       the last settings posted; a new session removes it (the
#                  real server resets its settings per session)
#   helper-<n>.xml the tree for the n-th source; past the last one, the last
#   sources        how many sources were asked for
#   source-mode    "nonxml": every source answers something that is not a
#                  tree; "nonxml-once": only the next one; "slow": every
#                  source answers after 3 s; "die": the next source stops the
#                  helper and is not answered
#   http-log       every request, one per line
import json, os, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

d = sys.argv[1]
def path(n): return os.path.join(d, n)
def has(n): return os.path.exists(path(n))
def read(n, default=""):
    try:
        with open(path(n)) as fh: return fh.read()
    except OSError: return default
def write(n, t):
    with open(path(n), "w") as fh: fh.write(t)

class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def answer(self, code, value, sid=None):
        b = json.dumps({"sessionId": sid, "value": value}).encode()
        self.send_response(code); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
    def handle_any(self, method):
        with open(path("http-log"), "a") as fh: fh.write("%s %s\n" % (method, self.path))
        if not has("running"):
            self.close_connection = True; return
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n).decode() if n else ""
        parts = self.path.strip("/").split("/")
        sid = read("session")
        if self.path == "/status": return self.answer(200, {"ready": True})
        if method == "POST" and self.path == "/session":
            s = "s%d" % (int(read("sessions", "0") or 0) + 1)
            write("sessions", s[1:]); write("session", s)
            if has("settings"): os.remove(path("settings"))
            return self.answer(200, {"sessionId": s, "capabilities": {}}, s)
        if len(parts) >= 2 and parts[0] == "session" and parts[1] != sid:
            return self.answer(404, {"error": "invalid session id"})
        if parts[2:] == ["appium", "settings"] and method == "POST":
            write("settings", body); return self.answer(200, None, sid)
        if parts[2:] == ["source"]:
            k = int(read("sources", "0") or 0) + 1; write("sources", str(k))
            mode = read("source-mode").strip()
            if mode == "die":
                os.remove(path("source-mode")); os.remove(path("running"))
                self.close_connection = True; return
            if mode == "slow": time.sleep(3)
            if mode in ("nonxml", "nonxml-once"):
                if mode == "nonxml-once": os.remove(path("source-mode"))
                return self.answer(200, "not a tree", sid)
            while k > 1 and not has("helper-%d.xml" % k): k -= 1
            return self.answer(200, read("helper-%d.xml" % k), sid)
        return self.answer(404, {"error": "unknown command"})
    def do_GET(self): self.handle_any("GET")
    def do_POST(self): self.handle_any("POST")

srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
srv.daemon_threads = True
write("server-port.tmp", str(srv.server_address[1])); os.rename(path("server-port.tmp"), path("server-port"))
srv.serve_forever()
