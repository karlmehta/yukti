#!/usr/bin/env python3
# A stand-in for a project's fixture service (#55), on 127.0.0.1 at a port of
# its own choosing, written to $1/port. Every request is one JSON line in
# $1/requests: the path, the two headers the engine may send (Authorization,
# X-Device-Timezone) and the body. The answer to /<name> is the file
# $1/answer-<name>: its first line the status, the rest the body; no such file
# is a 404. It stops when $1/stop appears, or after a minute.
import http.server, json, os, sys, threading, time

d = sys.argv[1]

class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n).decode("utf-8")
        with open(os.path.join(d, "requests"), "a") as fh:
            fh.write(json.dumps({"path": self.path, "auth": self.headers.get("Authorization"),
                                 "tz": self.headers.get("X-Device-Timezone"), "body": json.loads(body or "null")}) + "\n")
        try:
            with open(os.path.join(d, "answer-" + self.path.lstrip("/"))) as fh: text = fh.read()
        except OSError: text = "404\n"
        code, _, rest = text.partition("\n")
        code = int(code)
        self.send_response(code)
        if 300 <= code < 400: self.send_header("Location", "http://127.0.0.1:9/elsewhere")
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(rest.encode("utf-8"))))
        self.end_headers()
        self.wfile.write(rest.encode("utf-8"))
    def log_message(self, *a): pass

srv = http.server.HTTPServer(("127.0.0.1", 0), H)
with open(os.path.join(d, "port.tmp"), "w") as fh: fh.write(str(srv.server_address[1]))
os.rename(os.path.join(d, "port.tmp"), os.path.join(d, "port"))
threading.Thread(target=srv.serve_forever, daemon=True).start()
t = time.time()
while not os.path.exists(os.path.join(d, "stop")) and time.time() - t < 60: time.sleep(0.1)
srv.shutdown()
