#!/usr/bin/env python3
# A stand-in for adb, so tests/run.sh can drive the engine through a failing
# step on a machine with no device. tests/run.sh puts it first in PATH by
# pointing ANDROID_HOME at tests/fake-sdk. It answers only what a flow of
# waitForId, assertId, tap, type, clearText, clearTextId and screenshot asks,
# from files in $FAKE_ADB_DIR:
#
#   log            every call, one per line - a case checks it is not empty, or
#                  a case that passed on a real adb would look the same
#   dump-<n>.xml   the screen for the n-th dump; past the last one, the last.
#                  ="@TYPED@" in it becomes the text typed so far, quoted the
#                  way uiautomator quotes it: in ' when the text holds a "
#   dumps          how many dumps were taken - a case counts the reads with it
#   dump-delay     seconds every dump takes: a dump longer than a wait's timeout
#                  makes the poll a single one, whatever the clock does
#   typed          the text in the field; a case may write it first
#   hint           what the field shows while it is empty, as Android reports it
#   lossy          present: every burst of typed text loses its last character;
#                  holding a number n: only the first n bursts do
#   filter         the characters the field keeps; any other typed character
#                  is dropped, as a digits-only field drops letters (#128)
#   tap-fails      present: `input tap` exits 1
#   screencap      "fail": exit 1; "hang": never answer; absent: a small PNG
#   no-density     present: `wm density` answers nothing, as a device may
# `wm density` takes what arrives on its standard input within 0.2 s, as a real
# `adb shell` forwards its input to the device while the command runs: a call
# that would swallow a pipe meant for something else swallows it here too.
#
# The screen helper (tests/fake-sdk/uia2-server) shares the directory:
#   running        the helper is up; a dump while it is gets killed (empty)
#   foreign        another tool's helper is up: the same, for the dump
#   server-port    where the fake helper listens; a forward points there
#   forward        the local port of this device's forward to the helper
#   installed      both helper packages are on the device
#   start-fails    present: `am instrument` exits at once, nothing comes up
#
# The app under test, asked about after a step failed (#63):
#   app-pid        what `pidof <app>` prints; absent: nothing, status 1;
#                  "hang": never answers
#   focus          what `dumpsys window | grep ...` prints
#   device-offset  seconds the device clock is ahead of this machine's
#   crash          what `logcat -b crash` prints; "hang": never answers;
#                  "fail": status 1
#
# Permissions (#51): `sdk` is what getprop answers for the API level (35 when
# absent), `requested` the permissions the app's manifest asks for, `perms`
# their runtime state as the pm calls leave it, `pm-refuses` what pm grant /
# revoke / *-permission-flags print instead of nothing, and `pm-ignores` a pm
# that answers nothing and changes nothing, `filler` a number of lines
# `dumpsys package` prints after the manifest. `user10` adds a work profile after
# User 0, every permission there not granted and not answered.
#
# `dumpsys input_method` answers that no keyboard is up, unless the file
# `keyboard` is there; the escape key (111) removes it, and so does Back (4)
# unless the file `back-stays` is there. `kb-reads` overrides the answer, one
# word per read ("up" or "down"), first word first; past the last, the file
# `keyboard` answers again. `modal` stands for a dialog around the field: an
# escape removes it, as a React Native Modal takes escape as Back and closes,
# and so does a Back with no keyboard up; Back while the keyboard is up does
# not reach it. While `modal` holds text, `dumpsys window` prints that text
# (the dialog's window has focus) instead of the file `focus`.
import os, sys, time
from xml.sax.saxutils import quoteattr

d = os.environ["FAKE_ADB_DIR"]
args = sys.argv[1:]
line = " ".join(args)
with open(os.path.join(d, "log"), "a") as fh:
    fh.write(line + "\n")

def path(name): return os.path.join(d, name)
def has(name): return os.path.exists(path(name))
def read(name, default=""):
    try:
        with open(path(name)) as fh: return fh.read()
    except OSError: return default
def write(name, text):
    with open(path(name), "w") as fh: fh.write(text)

HELPER = "io.appium.uiautomator2.server"
if "uiautomator dump" in line:
    n = int(read("dumps", "0") or 0) + 1
    write("dumps", str(n))
    # One UiAutomation per device: a live helper kills the dump on the spot.
    if has("running") or has("foreign"): sys.exit(0)
    if has("dump-delay"): time.sleep(float(read("dump-delay")))
    while n > 1 and not has("dump-%d.xml" % n): n -= 1
    # quoteattr quotes as uiautomator does on a device (measured on an API 34
    # emulator): "..." as a rule, '...' around a value that holds a ".
    sys.stdout.write(read("dump-%d.xml" % n).replace('="@TYPED@"', "=" + quoteattr(read("typed") or read("hint"))))
elif args[:1] == ["shell"] and line.startswith("shell input text "):
    q = line[len("shell input text "):]
    if q.startswith("'") and q.endswith("'"): q = q[1:-1]
    q = q.replace("'\\''", "'").replace("%s", " ")
    if has("lossy"):
        left = read("lossy").strip()
        if not left: q = q[:-1]
        elif int(left) > 0: q = q[:-1]; write("lossy", str(int(left) - 1))
    if has("filter"): q = "".join(c for c in q if c in read("filter"))
    write("typed", read("typed") + q)
elif args[:3] == ["shell", "input", "keycombination"]:
    if args[3:] == ["113", "29"]: write("selected", "1")   # Ctrl+A
elif args[:3] == ["shell", "input", "keyevent"]:
    typed = read("typed")
    for k in args[3:]:
        if k == "111":
            if has("keyboard"): os.remove(path("keyboard"))
            if has("modal"): os.remove(path("modal"))
        if k == "4":
            if not has("keyboard"):
                if has("modal"): os.remove(path("modal"))
            elif not has("back-stays"): os.remove(path("keyboard"))
        if k == "67":
            # A delete takes the selection when there is one, else a character.
            if has("selected"): typed = ""; os.remove(path("selected"))
            else: typed = typed[:-1]
    write("typed", typed)
elif line == "shell getprop persist.sys.timezone":
    # The device's zone (#55): `timezone`, nothing when it is not there.
    print(read("timezone").strip())
elif line == "shell getprop ro.build.version.sdk":
    print(read("sdk").strip() or "35")
elif args[:3] == ["shell", "dumpsys", "package"] and len(args) == 4:
    # The permissions the app asks for (#51), one per line in `requested`, in
    # the shape dumpsys prints them, and their runtime state from `perms`: one
    # "<name> <granted true|false> <flags>" line each, kept by the pm calls.
    st = {}
    for l in read("perms").splitlines():
        f = l.split()
        if len(f) >= 2: st[f[0]] = (f[1], f[2] if len(f) > 2 else "")
    print("Packages:\n  Package [%s] (abc):\n    requested permissions:" % args[3])
    for p in read("requested").split():
        print("      " + p)
    print("    install permissions:\n      android.permission.INTERNET: granted=true")
    print("    User 0: ceDataInode=1 installed=true\n      runtime permissions:")
    for p in read("requested").split():
        if p == "android.permission.INTERNET": continue
        g, fl = st.get(p, ("false", ""))
        print("        %s: granted=%s, flags=[ %s]" % (p, g, (fl.replace(",", "|") + " ") if fl else ""))
    # `filler` is a count of further lines, as a real dumpsys goes on for
    # thousands (#168): more than a pipe holds, after User 0's block (before
    # User 10's when there is one).
    for n in range(int(read("filler").strip() or 0)): print("      filler entry %d: some more of the package dump" % n)
    if has("user10"):
        print("    User 10: ceDataInode=2 installed=true\n      runtime permissions:")
        for p in read("requested").split():
            if p != "android.permission.INTERNET": print("        %s: granted=false, flags=[ ]" % p)
elif len(args) == 2 and args[0] == "shell" and args[1].startswith("pm ") and ("permission-flags" in args[1] or "pm grant " in args[1] or "pm revoke " in args[1]):
    # A pm refusal is words on stdout (`pm-refuses`), as on a real device;
    # `pm-ignores` answers nothing and changes nothing - the case a read back
    # exists for. Otherwise the calls change `perms`.
    sys.stdout.write(read("pm-refuses"))
    if not has("pm-refuses") and not has("pm-ignores"):
        st = {}
        for l in read("perms").splitlines():
            f = l.split()
            if len(f) >= 2: st[f[0]] = [f[1], set(f[2].split(",")) if len(f) > 2 and f[2] else set()]
        for cmd in args[1].split(";"):
            f = cmd.split()
            if len(f) < 4: continue
            e = st.setdefault(f[3], ["false", set()])
            if f[1] == "grant": e[0] = "true"
            elif f[1] == "revoke": e[0] = "false"
            elif f[1] == "set-permission-flags": e[1] |= {x.upper().replace("-", "_") for x in f[4:]}
            elif f[1] == "clear-permission-flags": e[1] -= {x.upper().replace("-", "_") for x in f[4:]}
        write("perms", "".join("%s %s %s\n" % (k, v[0], ",".join(sorted(v[1]))) for k, v in st.items()))
elif args[:3] == ["shell", "input", "tap"]:
    sys.exit(1 if has("tap-fails") else 0)
elif args[:2] == ["exec-out", "screencap"]:
    mode = read("screencap").strip()
    if mode == "fail": sys.exit(1)
    if mode == "hang": time.sleep(120)
    sys.stdout.buffer.write(b"\x89PNG\r\n\x1a\n" + b"\0" * 32)
elif line == "shell dumpsys input_method":
    # A swipe step asks first (kb_before_swipe).
    up = has("keyboard")
    seq = read("kb-reads").split()
    if seq:
        up = seq[0] == "up"; write("kb-reads", " ".join(seq[1:]))
    print("  mInputShown=%s" % ("true" if up else "false"))
elif line == "shell wm size":
    print("Physical size: 1080x2400")
elif line == "shell wm density":
    import select
    if not sys.stdin.isatty() and select.select([sys.stdin], [], [], 0.2)[0]: sys.stdin.read()
    if not has("no-density"): print("Physical density: 420")
elif args[:1] == ["devices"]:
    print("List of devices attached\nemulator-5554\tdevice\n")
elif args == ["get-serialno"]:
    print("emulator-5554")
elif args == ["forward", "--list"]:
    if has("forward"): print("emulator-5554 tcp:%s tcp:6790" % read("forward").strip())
elif args == ["forward", "tcp:0", "tcp:6790"]:
    p = read("server-port").strip()
    if not p: sys.exit(1)
    write("forward", p); print(p)
elif args[:2] == ["forward", "--remove"]:
    if has("forward") and args[2:] == ["tcp:" + read("forward").strip()]: os.remove(path("forward"))
elif args == ["shell", "pidof", HELPER]:
    if has("running") or has("foreign"): print("4242")
    else: sys.exit(1)
elif args[:2] == ["shell", "pidof"] and len(args) == 3:
    pid = read("app-pid").strip()
    if pid == "hang": time.sleep(120)
    if not pid: sys.exit(1)
    print(pid)
elif args[:1] == ["shell"] and len(args) == 2 and args[1].startswith("dumpsys window"):
    sys.stdout.write(read("modal") if read("modal").strip() else read("focus"))
elif args == ["shell", "date", "+%s"]:
    print(int(time.time() + float(read("device-offset", "0") or 0)))
elif args[:4] == ["logcat", "-b", "crash", "-d"]:
    mode = read("crash")
    if mode.strip() == "hang": time.sleep(120)
    if mode.strip() == "fail": sys.exit(1)
    sys.stdout.write(mode)
elif args[:3] == ["shell", "pm", "clear"]:
    print("Success")
elif args == ["shell", "am force-stop %s; am force-stop %s.test" % (HELPER, HELPER)]:
    if has("running"): os.remove(path("running"))
elif args == ["shell", "pm path %s; pm path %s.test" % (HELPER, HELPER)]:
    if has("installed"): print("package:/data/app/server/base.apk\npackage:/data/app/test/base.apk")
elif args[:3] == ["install", "-r", "-g"]:
    write("installed", "")
elif args[:4] == ["shell", "am", "instrument", "-w"]:
    # The real client returns when the instrumentation ends; this one when the
    # helper is stopped, or after a minute so a forgotten case cannot hang.
    if has("start-fails"): sys.exit(1)
    write("running", "")
    t = time.time()
    while has("running") and time.time() - t < 60: time.sleep(0.1)
