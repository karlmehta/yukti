#!/usr/bin/env python3
# A stand-in for curl, first in PATH with the fake adb, so a case that makes
# the engine fetch the helper's APKs never touches the network. The file it
# "downloads" is $FAKE_ADB_DIR/download-<name of the file in the address>; none
# there, it fails the way curl -f fails on a 404.
import os, shutil, sys
d = os.environ["FAKE_ADB_DIR"]; a = sys.argv[1:]
url = [x for x in a if x.startswith("http")][-1]
out = a[a.index("-o") + 1]
with open(os.path.join(d, "log"), "a") as fh: fh.write("curl " + url + "\n")
src = os.path.join(d, "download-" + url.rsplit("/", 1)[-1])
if not os.path.exists(src): sys.exit(22)
shutil.copy(src, out)
