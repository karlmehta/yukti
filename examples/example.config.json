{
  "projectRoot": ".",
  "platform": "ios",
  "workspace": "ios/YourApp.xcworkspace",
  "simulator": {
    "device": "iPhone 16 Pro"
  },
  "android": {
    "avd": "Pixel_7_API_34"
  },
  "urls": {
    "home": "home",
    "cart": "cart",
    "order": "orders/latest"
  },
  "excludeIosAutolink": [
    "@some/device-only-native-module"
  ],
  "easEnabled": false,
  "variants": {
    "qa": {
      "scheme": "YourApp",
      "configuration": "Release",
      "bundleId": "com.example.yourapp",
      "envFile": ".env.qa",
      "appVariant": "development",
      "nodeEnv": "development",
      "easProfile": "simulator",
      "urlBase": "myapp://"
    },
    "prod": {
      "scheme": "YourApp",
      "configuration": "Release",
      "bundleId": "com.example.yourapp",
      "envFile": ".env.production",
      "appVariant": "production",
      "nodeEnv": "production",
      "easProfile": "simulator",
      "urlBase": "myappprod://"
    },
    "android-qa": {
      "platform": "android",
      "package": "com.example.yourapp",
      "gradleTask": "assembleDebug",
      "apkPath": "",
      "envFile": ".env.qa",
      "urlBase": "myapp://"
    }
  }
}
