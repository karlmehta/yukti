# A swipe that starts on a soft keyboard is taken by the keyboard: Gboard reads a
# drag across its keys as glide typing and types a word into the focused field,
# and the list behind it does not move. So the first swipe of a step asks first.
# Up: closed, the way hideKeyboard closes it, and said in the run (status 3, so a
# search reads the screen again - what it looks for may have been under the keys).
# Not closing, or no answer from the device, stops the step: an unanswered
# question is not "no keyboard". Closing drops focus from the field - a flow that
# types after a scroll taps the field first.
kb_before_swipe(){ local who="$1, before the first swipe" st=0
  kb_shown || st=$?
  if [ "$st" -eq 1 ]; then return 0; fi
  if [ "$st" -eq 2 ]; then die "$who: the device did not report its input method state"; fi
  kb_close "$who"
