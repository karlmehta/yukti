# scroll_to is a locator and stays one: it is also the first half of tapText,
# which has its own words for a miss. As a STEP, though, scrollToText is a
# statement that the label is there - the flow swipes until it finds it - and a
# statement that turns out false has to fail. It did not: the swipes ended, the
# last lookup came back empty, and the step passed. The runbook recommends this
# step in front of an assertion, so the documented way to reach something below
# the fold was also the way to miss it in silence.
scroll_to_step(){ local lbl="${1:-}" dir="${2:-down}" clear="${3:-}" xy st=0
  [ -n "$lbl" ] || die "scrollToText needs a non-empty value"
  case "$dir" in up|down|left|right) ;; *) die "scrollToText: '$dir' is not a direction - use up, down, left or right";; esac
  case "$clear" in ''|clear) ;; *) die "scrollToText: '$clear' is not a value for \"edges\" - the only one is clear";; esac
  xy="$(scroll_to "$lbl" "$dir" "$clear")" || st=$?
  # Neither 4, 5 nor 9 says the direction: once the element is on the screen the
  # swipes follow its position, not the direction the search came from.
  case "$st" in
    0) ;;
    4) die "scrollToText: '$lbl' came into view but never landed clear of the band edges after $SCROLL_TRIES swipes - it is at $xy";;
    5) die "scrollToText: '$lbl' came into view at $xy and the swipes took it out of view again - it is not on the screen now";;
    6|7|8) die "scrollToText: $(scroll_miss "$st" "$lbl" "$dir")";;
    9) die "scrollToText: '$lbl' is at the end of the list and cannot be moved clear of the band edge - it is at $xy; content may be hidden under a fixed bar";;
    *) lookup_die "$st";;
  esac
  # Not reached today - every miss above has its own status - and kept so that a
  # new path through scroll_to cannot pass this step with nothing to show.
  [ -n "$xy" ] || die "scrollToText: '$lbl' not on screen"
  printf '%s\n' "$xy"; }

# ── per-flow results ─────────────────────────────────────────────────────────
# A run left console text and screenshots and nothing a tool could read: which
# flow, which step, how long, where the artifacts are. That is enough at ten
# flows and useless at a hundred - no report, no history, no way to tell a
# permanent failure from a flaky one. Every flow now also leaves one JUnit XML
# file, the format report viewers and CI already understand.
#
# Written from an EXIT trap rather than after the loop: a failing step exits the
# whole run, so a result produced only on success would be missing exactly when
# it is needed. Steps are appended as they finish; the step that started and
# never finished is the one that failed.
RESULTS_DIR="${YUKTI_RESULTS_DIR:-yukti-results}"
FLOW_IDX=0
now(){ if [ -n "${EPOCHREALTIME:-}" ]; then printf '%s' "${EPOCHREALTIME/,/.}"; else date +%s; fi; }

flow_results(){
  local st="${1:-0}" out
  [ -n "${FLOW_REC:-}" ] || return 0
  trap - EXIT
  out="$("$PY" - "$FLOW_FILE" "$FLOW_REC" "$FLOW_CUR" "$FLOW_ERR" "$FLOW_T0" "$(now)" "$st" "$RESULTS_DIR" "$YUKTI_PLATFORM" <<'PY'
import os, sys, time
from xml.sax.saxutils import escape, quoteattr

flow, rec, cur, errf, t0, t1, st, outdir, plat = sys.argv[1:10]
SEP = "\x1f"

def num(v, d=0.0):
    try: return float(v)
    except ValueError: return d

def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh: return fh.read()
    except OSError: return ""

steps = []
# split("\n"), not splitlines(): the latter also cuts on \r and on half a dozen
# other characters, so a value carrying one of them split its own record and the
# step vanished from the report - green run, no steps in the file.
for line in read(rec).split("\n"):
    if not line: continue
    parts = line.split(SEP)
    if len(parts) < 6: continue
    i, verb, value, s0, s1, art = parts[:6]
    # The seventh field is the condition that switched the step off, empty for a
    # step that ran. The eighth is the block the step was written in, empty for
    # the flow file itself. The ninth is the step's title. Older records have
    # six, seven or eight fields.
    skip = parts[6] if len(parts) > 6 else ""
    src = parts[7] if len(parts) > 7 else ""
    title = parts[8] if len(parts) > 8 else ""
    steps.append({"i": int(num(i)), "verb": verb, "value": value,
                  "t": max(0.0, num(s1) - num(s0)), "art": art, "skip": skip, "src": src,
                  "title": title})

failing = None
if int(num(st)) != 0:
    parts = read(cur).strip("\n").split(SEP)
    if len(parts) >= 4 and parts[0] and not any(x["i"] == int(num(parts[0])) for x in steps):
        failing = {"i": int(num(parts[0])), "verb": parts[1], "value": parts[2],
                   "t": max(0.0, num(t1) - num(parts[3])), "art": "", "skip": "",
                   "src": parts[4] if len(parts) > 4 else "",
                   "title": parts[5] if len(parts) > 5 else ""}

msg = read(errf).strip() or "the run stopped with exit code %d" % int(num(st))

# A typed string is a credential as often as not - the flow files take
# ${TEST_PASSWORD} from the environment. The result file records how much was
# typed, never what: an artifact that leaks the password is worse than no
# artifact, and the console already prints the same count.
def shown(step):
    verb, value = step["verb"], step["value"]
    if verb in ("type", "clearText"):
        value = "%d chars" % len(value) if value else ""
    if len(value) > 60: value = value[:57] + "..."
    # A step with a title is named by it: the reader of a failed run needs what
    # the step was for, not the id it tapped. The value stays after it, shown as
    # it is without a title: a block included by two flows with different
    # values would otherwise name its steps the same in both. The block leads.
    if step["title"]:
        verb = step["title"] + (":" if value and not step["title"].endswith(":") else "")
    # A step from a block says which block, the way the console does: two flows
    # that include the same block would otherwise show its steps as their own.
    # A step of the flow file itself is named as it always was.
    if step["src"]:
        return ("%02d [%s] %s %s" % (step["i"], step["src"], verb, value)).strip()
    return ("%02d %s %s" % (step["i"], verb, value)).strip()

stem = os.path.splitext(os.path.basename(flow))[0] or "flow"
cases = []
for step in steps:
    if step["skip"]:
        # A step that did not run is not a step that passed. Reported as skipped,
        # with the condition in the message: a reader of the file can see which
        # part of the flow was switched off and by what.
        cases.append('    <testcase classname=%s name=%s time="%.3f">\n'
                     '      <skipped message=%s/>\n'
                     '    </testcase>'
                     % (quoteattr(stem), quoteattr(shown(step)), step["t"],
                        quoteattr("condition not met: " + step["skip"])))
    else:
        cases.append('    <testcase classname=%s name=%s time="%.3f"/>'
                     % (quoteattr(stem), quoteattr(shown(step)), step["t"]))
if failing is not None:
    cases.append('    <testcase classname=%s name=%s time="%.3f">\n'
                 '      <failure message=%s type="StepFailed"/>\n'
                 '    </testcase>'
                 % (quoteattr(stem), quoteattr(shown(failing)), failing["t"], quoteattr(msg)))
elif int(num(st)) != 0:
    # The run died before or between steps: still a failure, and a result that
    # said "all green, exit 1" would be worse than none.
    cases.append('    <testcase classname=%s name="00 flow" time="0.000">\n'
                 '      <failure message=%s type="FlowFailed"/>\n'
                 '    </testcase>' % (quoteattr(stem), quoteattr(msg)))

skips = sum(1 for s in steps if s["skip"])
arts = [s["art"] for s in steps if s["art"]]
out = [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<testsuites>',
    '  <testsuite name=%s tests="%d" failures="%d" errors="0" skipped="%d" time="%.3f" timestamp=%s>'
    % (quoteattr(stem), len(cases), 0 if failing is None and int(num(st)) == 0 else 1,
       skips, max(0.0, num(t1) - num(t0)),
       quoteattr(time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(num(t0))))),
    '    <properties>',
    '      <property name="platform" value=%s/>' % quoteattr(plat),
    '      <property name="flow" value=%s/>' % quoteattr(flow),
    '    </properties>',
]
out.extend(cases)
if arts:
    out.append('    <system-out>' + escape("\n".join(arts)) + '</system-out>')
out.append('  </testsuite>')
out.append('</testsuites>')

os.makedirs(outdir, exist_ok=True)
path = os.path.join(outdir, stem + ".xml")
with open(path, "w", encoding="utf-8") as fh:
    fh.write("\n".join(out) + "\n")
print(path)
PY
)" && ok "results → $out" || warn "could not write the results file to '$RESULTS_DIR'"
  rm -f "$FLOW_REC" "$FLOW_CUR" "$FLOW_ERR"; FLOW_REC=""
  return 0
}

# ── deterministic flow runner: a JSON list of steps ──────────────────────────
# step keys: include[with]|launch|stopApp|clearState|wait|waitFor[timeout,match]|waitForId[timeout]|screenshot|
#            openUrl|tap[x,y]|tapText|optionalTapText|tapId|type|clearText[x,y]|clearTextId|pressKey|hideKeyboard|
#            scroll|scrollToText[direction,edges]|dismiss|assertText[match]|assertId|assertNotText[match]|assertNotId|
#            assertBox[box]|assertBoxId[box]
#            any step, and an include, may carry "when": {visible|notVisible|
#            visibleId|notVisibleId|platform} - all of them have to hold
#
# The same names the dispatcher inside flow() knows, as a list a check can read.
# The dispatcher cannot answer "do you know this name?" without running the
# step, and one check below has to ask before the step runs. A verb added to the
# `case` has to be added here too: nothing but this comment ties the two, and
# the `*)` arm of the dispatcher stays as the backstop.
#
# `include` is deliberately in neither: the builder runs it while it reads the
# file and emits the block's steps in its place, so no record ever carries it
# and the dispatcher never sees it. `__when` is not in either list for the same
# reason from the other side: it is a record the loop answers itself, never a
# name a flow file may use - a step whose name starts with "__" is refused as
# unknown by the check above the dispatcher.
# ── step conditions (`when`) ─────────────────────────────────────────────────
# A condition has three outcomes, and only one of them is a skip:
#   it holds          - the guarded steps run, and the run says nothing about it
#   it does not hold  - they are skipped, out loud: a line each and `skipped` in
#                       the report, because a condition that quietly removes
#                       steps from a suite is a worse defect than the missing
#                       `when` it replaces
#   it cannot be answered - the run stops
#
# The third one is why conditions and the negative assertions are one change: an
# unreadable screen, or a screen that does not report its own bounds, answers
# every "is this visible?" with "no". Taken as an answer, that switches parts of
# a suite off and keeps the run green.
#
# `visible`/`notVisible` ask the ASSERTION oracle, not the tap locator. The
# locator folds case, matches substrings and looks into resource-ids, so a
# condition answered by it can be satisfied by markup - and this condition
# decides whether a step runs at all. `visibleId`/`notVisibleId` are the exact
# id selector, the rule assertId already follows. The cost is named in the
# guide: a condition is stricter than tapText, so it can skip a step tapText
# would have found - and the skip is never silent.
COND_KV=$'\x1d'; COND_SEP=$'\x1e'
cond_holds(){ local spec="$1" pair kind val xy st
  while [ -n "$spec" ]; do
    case "$spec" in *"$COND_SEP"*) pair="${spec%%"$COND_SEP"*}"; spec="${spec#*"$COND_SEP"}";; *) pair="$spec"; spec="";; esac
    kind="${pair%%"$COND_KV"*}"; val="${pair#*"$COND_KV"}"
    case "$kind" in
      # The platform of this run, as the engine resolved it at start-up: the
      # variant's platform, else the config's, else ios. That last fallback is
      # issue #36 and a condition inherits it, so the skip line below names the
      # platform it compared against - an author who expected android sees why
      # the step did not run instead of wondering.
      platform) [ "$val" = "${YUKTI_PLATFORM:-}" ] || return 1;;
      visible|notVisible|visibleId|notVisibleId)
        st=0
        case "$kind" in
          visible|notVisible)     xy="$(find_el "$val" assert exact)" || st=$?;;
          visibleId|notVisibleId) xy="$(find_el "$val" id)" || st=$?;;
        esac
        [ "$st" -eq 0 ] || die "when ($kind '$val'): $(lookup_err "$st")"
        case "$kind" in
          visible|visibleId)       [ -n "$xy" ] || return 1;;
          notVisible|notVisibleId) [ -z "$xy" ] || return 1;;
        esac;;
      # The builder refuses an unknown condition before the run starts. This arm
      # is the backstop for a record that reached the loop some other way.
      *) die "when: '$kind' is not a condition this version knows";;
    esac
  done
  return 0; }
# The condition in the author's words, for the line that says what was skipped.
cond_words(){ local spec="$1" pair kind val out=""
  while [ -n "$spec" ]; do
    case "$spec" in *"$COND_SEP"*) pair="${spec%%"$COND_SEP"*}"; spec="${spec#*"$COND_SEP"}";; *) pair="$spec"; spec="";; esac
    kind="${pair%%"$COND_KV"*}"; val="${pair#*"$COND_KV"}"
    case "$kind" in
      platform) out="$out${out:+ and }platform '$val' (this run: ${YUKTI_PLATFORM:-unset})";;
      *)        out="$out${out:+ and }$kind '$val'";;
    esac
  done
  printf '%s' "$out"; }
FLOW_VERBS="launch stopApp clearState openUrl wait waitFor waitForId screenshot tap tapText optionalTapText tapId type clearText clearTextId pressKey hideKeyboard scroll scrollToText dismiss assertText assertId assertNotText assertNotId assertBox assertBoxId"
# The steps a condition switched off. They keep their numbers - the numbering is
# end to end, and a skipped step that gave its number away would move every step
# after it - they say so on the console, and they land in the report as `skipped`
# with the condition that switched them off. A nested guard inside the group is
# not a step and takes no number: it is skipped together with its group.
flow_skip(){ local n="${1:-1}" why="$2" i=0 d v xx yy mm tt dd ee ss si wc ws bx tl t
  why="${why//[$'\n\r']/ }"
  while [ "$i" -lt "$n" ] && IFS=$'\x1f' read -r -d '' d v xx yy mm tt dd ee ss si wc ws bx tl <&3; do
    i=$((i+1))
    if [ "$d" = "__when" ]; then continue; fi
    FLOW_IDX=$((FLOW_IDX+1)); t="$(now)"
    skipped "step $FLOW_IDX '$d'${tl:+ \"$tl\"} skipped: $why"
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$FLOW_IDX" "$d" "${v//[$'\n\r']/ }" "$t" "$t" "" "$why" "${ss//[$'\n\r']/ }" "$tl" >> "$FLOW_REC"
  done; }
flow(){
  # --check builds the flow and stops there: every step is read, resolved and
  # validated, and not one of them is performed. It needs no simulator and no
  # emulator, which is what makes it the only part of a flow a CI runner can
  # look at. A step whose condition decides at run time whether it runs is
  # checked all the same - the screen is never asked, so the condition is not
  # answered here, only its spelling is.
  local chk=0 a args=""
  # The flag is read wherever it stands. Written after the file name it used to
  # be one more argument nobody looked at, so `yukti flow x.json --check` ran the
  # flow: a check that performs the steps it was asked to only inspect fails in
  # the one direction a check must not. Anything else left over is a typo, and a
  # typo that is ignored is an instruction that did not happen.
  for a in "$@"; do
    case "$a" in
      --check) chk=1;;
      -*) die "unknown option '$a' - usage: yukti flow [--check] <file.json>";;
      *) [ -z "$args" ] || die "one flow file at a time - usage: yukti flow [--check] <file.json>"
         args="$a";;
    esac
  done
  [ -n "$args" ] || die "usage: yukti flow [--check] <file.json>"
  local f="$args" st; [ -f "$f" ] || die "no flow file '$f'"; paths
  FLOW_FILE="$f"; FLOW_IDX=0; FLOW_ART=""
  if [ "$chk" = 1 ]; then
    say "checking flow: $f"
  else
    say "running flow: $f"
    FLOW_REC="$(mktemp)"; FLOW_CUR="$(mktemp)"; FLOW_ERR="$(mktemp)"; FLOW_T0="$(now)"
    export YUKTI_STEP_ERR="$FLOW_ERR"
    # Nothing ran, so nothing is reported: a JUnit file written by --check would
    # say a flow passed on a machine that never had a device.
    trap 'flow_results $?; run_dir_cleanup' EXIT
  fi
  # The steps are built before the first one runs, and a flow file the builder
  # refuses never starts. It used to be generated straight into the loop, where
  # its status was lost with the process substitution: a flow file that is not
  # valid JSON, or one carrying a variable that is not set, produced no steps
  # and the run still ended with "flow complete".
  local steps gerr gmsg
  steps="$(mktemp)"; gerr="$(mktemp)"
  if ! "$PY" - "$f" > "$steps" 2> "$gerr" <<'PY'
import json, os, re, sys

def fail(msg):
    sys.stderr.write(msg + "\n"); sys.exit(2)

# The same forms os.path.expandvars accepted, minus its silence: it returns the
# text unchanged when the variable is not set, so ${TEST_PASSWORD} was typed
# into whatever held focus as a literal and the log said `type 16 chars`.
VAR = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)")
NAME = re.compile(r"\A[A-Za-z_][A-Za-z0-9_]*\Z")
# A record ends with NUL, the fields inside it are separated by US. A newline is
# then just a character in a value: a caption that wraps on screen is what an
# author copies out of it, and the lookup already folds whitespace on both sides
# of the comparison. Line-separated records cut such a value in half, ran the
# first half as the step and read the second as a step of its own.
SEP, END = "\x1f", "\0"
KEYS = ("do", "value", "x", "y", "match", "timeout", "direction", "edges")
# A step may also carry a condition. It is not one of the fields above: it is
# answered while the run goes on, and its answer decides whether the step runs.
WHEN_KINDS = ("notVisible", "notVisibleId", "platform", "visible", "visibleId")
# The box of an element, asserted by assertBox and assertBoxId. Like "when",
# this is a structured key: several constraints belong to one step, and they
# travel in one field rather than eight.
BOX_KINDS = ("maxHeight", "maxWidth", "maxX", "maxY",
             "minHeight", "minWidth", "minX", "minY")
# A title says what a step is for, in the author's words. It is for the reader
# of a run and nothing else: the step runs the same with it or without it.
STEP_KEYS = set(KEYS) | {"when", "box", "title"}
INCLUDE_KEYS = {"do", "value", "with", "when"}
# One condition is a kind and a value; several in one `when` all have to hold.
# These two characters separate them inside the single field that carries them.
KV, CSEP = "\x1d", "\x1e"
# `include` runs the steps of another flow file here. It is resolved while the
# steps are built, not while they run: the block's steps enter the stream as
# ordinary records, so the runner, the console and the JUnit file treat them
# exactly like steps written in the file itself - a failure inside the login
# block is a failed step in the report, not a silence.
#
# A flow may include a block, and that block may include one more. Deeper than
# that has no use we can name, and an author who hits the limit reads a message
# instead of watching the run expand.
MAX_DEPTH = 2

def load(path, what, pre=""):
    try:
        with open(path, encoding="utf-8") as fh: doc = json.load(fh)
    except ValueError as e:
        fail("%s%s is not valid JSON: %s" % (pre, what, e))
    except OSError as e:
        fail("%s%s cannot be read: %s" % (pre, what, e))
    if not isinstance(doc, dict) or not isinstance(doc.get("steps"), list):
        fail('%s%s has no "steps" list' % (pre, what))
    if not doc["steps"]:
        fail("%s%s has no steps - it would pass without doing anything" % (pre, what))
    return doc["steps"]

def when_spec(step, at, scope, src):
    if "when" not in step: return ""
    w = step["when"]
    if not isinstance(w, dict):
        fail('%s: "when" is an object of conditions, for instance '
             '{"visible": "Continue"} or {"platform": "android"}' % at)
    if not w:
        fail('%s: "when" is empty - name a condition (%s) or drop the key'
             % (at, ", ".join(WHEN_KINDS)))
    pairs = []
    for key in sorted(w):
        if key not in WHEN_KINDS:
            fail("%s: '%s' is not a condition - this version knows %s"
                 % (at, key, ", ".join(WHEN_KINDS)))
        v = w[key]
        if v is None or isinstance(v, (dict, list, bool)):
            fail("%s: condition '%s' must be text or a number" % (at, key))
        v = fill(v if isinstance(v, str) else str(v), scope, at, bool(src)).strip()
        if not v:
            fail("%s: condition '%s' has no value" % (at, key))
        if any(ch in v for ch in (SEP, END, KV, CSEP)):
            fail("%s: condition '%s' contains a character the runner separates "
                 "fields with" % (at, key))
        # A platform nobody runs on is not a condition, it is an off switch: the
        # step would be skipped on every run and the run would stay green.
        if key == "platform" and v not in ("android", "ios"):
            fail("%s: '%s' is not a platform - use android or ios" % (at, v))
        pairs.append(key + KV + v)
    return CSEP.join(pairs)

def title_of(step, at):
    if "title" not in step: return ""
    t = step["title"]
    if t is None:
        fail('%s: "title" is null - remove the key or give it a value' % at)
    if not isinstance(t, str):
        fail('%s: "title" is text that says what the step is for, for instance '
             '"open the account screen"' % at)
    # Taken as written: no ${VARIABLE} is expanded in it. A title is words for
    # the reader, and a report that spelled out ${TEST_PASSWORD} because a title
    # mentioned it would be the leak the typed-text rule exists to prevent.
    if SEP in t or END in t:
        fail('%s: "title" contains a character the runner separates fields '
             "with" % at)
    # One line: the report and the console both print it on one.
    t = " ".join(t.split())
    if not t:
        fail('%s: "title" is empty - say what the step is for or drop the key' % at)
    return t

def box_spec(step, at, scope, src):
    verb = step.get("do", "")
    if "box" not in step:
        # A box assertion with nothing to assert is a step that passes on any
        # element that is on the screen - which assertText and assertId already
        # say, more cheaply and more honestly.
        if verb in ("assertBox", "assertBoxId"):
            fail("%s: %s needs a \"box\" - the constraints are %s"
                 % (at, verb, ", ".join(BOX_KINDS)))
        return ""
    if verb not in ("assertBox", "assertBoxId"):
        fail('%s: step \'%s\' does not take a "box" - only assertBox and '
             "assertBoxId do" % (at, verb))
    b = step["box"]
    if not isinstance(b, dict):
        fail('%s: "box" is an object of constraints, for instance '
             '{"minWidth": 48, "minHeight": 48}' % at)
    if not b:
        fail('%s: "box" is empty - name a constraint (%s) or drop the step'
             % (at, ", ".join(BOX_KINDS)))
    pairs = []
    for key in sorted(b):
        if key not in BOX_KINDS:
            fail("%s: '%s' is not a constraint - this version knows %s"
                 % (at, key, ", ".join(BOX_KINDS)))
        v = b[key]
        if v is None or isinstance(v, (dict, list, bool)):
            fail("%s: constraint '%s' must be a number, for instance 48, "
                 '"48dp" or "5%%"' % (at, key))
        v = fill(v if isinstance(v, str) else str(v), scope, at, bool(src)).strip()
        # Pixels, dp or whole percent, and nothing else: the comparison runs in
        # the shell, where "48px", "4.5" or "" are not numbers and would either
        # abort the run with an arithmetic error or, worse, compare as zero.
        num = v[:-1] if v.endswith("%") else (v[:-2] if v.endswith("dp") else v)
        if not num.isdigit():
            fail("%s: constraint '%s' is '%s' - it has to be a whole number of "
                 'pixels (48), of dp ("48dp") or a whole share of the screen '
                 '("5%%")' % (at, key, v))
        # "08" is a number here and octal in the shell, where it dies in the
        # arithmetic with no step message and no JUnit entry. Normalised while
        # it is still text and the author can still be told what was written.
        v = str(int(num)) + v[len(num):]
        num = str(int(num))
        if v.endswith("%") and int(num) > 100:
            fail("%s: constraint '%s' is '%s' - a share of the screen cannot be "
                 "more than 100%%" % (at, key, v))
        pairs.append(key + KV + v)
    return CSEP.join(pairs)

def guard(cond, span, src, idx):
    # A condition is a record of its own, not another field on the step it
    # guards: a block included under a condition may carry a condition on its
    # own first step, and two conditions do not fit in one set of fields.
    #
    # The guard says how many of the records that follow belong to it, counted
    # here, where the group is still a group - by the time the run reads them
    # they are a flat stream. One answer then switches the whole group off, and
    # the screen cannot change halfway through it, which is exactly what
    # happens if the condition is re-asked at every step of the block: the
    # first step dismisses the dialog, and the rest of the block is skipped.
    return SEP.join(["__when"] + [""] * (len(KEYS) - 1) + [src, str(idx), cond, str(span), "", ""])

def fill(v, scope, at, inside):
    missing = []
    def one(m, missing=missing):
        name = m.group(1) or m.group(2)
        if name not in scope: missing.append(name); return ""
        return scope[name]
    v = VAR.sub(one, v)
    if missing:
        fail("%s: $%s is not set %s - the step would have used the text as "
             "written" % (at, missing[0],
                          'here: pass it in "with" on the include, or set it in '
                          "the environment" if inside else "in the environment"))
    return v

recs = []

def build(path, shown, src, scope, chain, depth, pre=""):
    # A block is named relative to the file that includes it: a suite is moved,
    # copied and run from anywhere as one directory, and the working directory
    # of the run is not something the flow file can know. Through the real path,
    # not the link: one shared directory of blocks symlinked into two suites
    # resolved the blocks' own includes next to the LINK, which is where a
    # same-named file of the borrowing suite sits.
    base = os.path.dirname(os.path.realpath(path))
    for idx, step in enumerate(load(path, shown, pre), 1):
        of = " of %s" % shown if src else ""
        if not isinstance(step, dict): fail("step %d%s is not an object" % (idx, of))
        verb = step.get("do") or ""
        at = "step %d '%s'%s" % (idx, verb, of)
        # The runner's own records are named with two leading underscores. A flow
        # file that used such a name would hand the loop a record it answers
        # itself - a forged guard, i.e. a step that quietly does nothing.
        if isinstance(verb, str) and verb.startswith("__"):
            fail("%s: a step name cannot start with __ - those belong to the "
                 "runner's own records" % at)
        if "with" in step and verb != "include":
            fail('%s: "with" passes values to an include - only include takes it'
                 % at)
        # A key nobody reads used to be mentioned by nobody. Tolerable while every
        # key did something visible; not tolerable next to a condition, where
        # `wehn` means a step that runs every time while the file says it is
        # conditional. The 45 flows this was measured against carry do, value, x
        # and y, so nothing in the suite depends on the old silence.
        if verb != "include":
            extra = sorted(k for k in step if k not in STEP_KEYS)
            if extra:
                fail("%s: '%s' is not a key a step takes - those are %s"
                     % (at, extra[0], ", ".join(sorted(STEP_KEYS))))
        cond = when_spec(step, at, scope, src)
        if verb == "include":
            # The guard is inserted after the block is built, because only then is
            # it known how many records it covers.
            pos = len(recs)
            include(step, at, base, src, scope, chain, depth)
            if cond: recs.insert(pos, guard(cond, len(recs) - pos, src, idx))
            continue
        fields = []
        for key in KEYS:
            v = step.get(key, "")
            if v is None:
                fail('%s: "%s" is null - remove the key or give it a value'
                     % (at, key))
            v = v if isinstance(v, str) else str(v)
            if key == "value":
                v = fill(v, scope, at, bool(src))
            if SEP in v or END in v:
                fail('%s: "%s" contains a character the runner separates fields '
                     "with" % (at, key))
            fields.append(v)
        # Which file the step was written in, carried so that a failure names it.
        # Empty for the flow file itself: the run already says which flow it is.
        fields.append(src)
        # And where it is in that file: the run numbers steps end to end, so the
        # number a failure prints is not the one to look for in the file.
        fields.append(str(idx))
        # The two fields a guard record uses. A step carries them empty: one
        # record shape for the loop to read, whatever the record is.
        fields.append("")
        fields.append("")
        fields.append(box_spec(step, at, scope, src))
        fields.append(title_of(step, at))
        if cond: recs.append(guard(cond, 1, src, idx))
        recs.append(SEP.join(fields))

def include(step, at, base, src, scope, chain, depth):
    for key in ("x", "y", "match", "timeout", "box"):
        if key in step:
            fail('%s: "%s" is not a key an include takes - it runs the steps '
                 "of a file, and those steps carry their own keys" % (at, key))
    extra = sorted(k for k in step if k not in INCLUDE_KEYS)
    if extra:
        fail("%s: '%s' is not a key an include takes - those are %s"
             % (at, extra[0], ", ".join(sorted(INCLUDE_KEYS))))
    name = step.get("value")
    if not isinstance(name, str) or not name.strip():
        fail('%s: "value" is the flow file to run here, for instance '
             '"blocks/login.json"' % at)
    name = fill(name.strip(), scope, at, bool(src))
    if SEP in name or END in name:
        fail('%s: "value" contains a character the runner separates fields '
             "with" % at)
    path = name if os.path.isabs(name) else os.path.join(base, name)
    real = os.path.realpath(path)
    trail = [c[1] for c in chain] + [name]
    if any(c[0] == real for c in chain):
        fail("%s: '%s' is already running - a block cannot include itself, "
             "directly or in a circle: %s" % (at, name, " -> ".join(trail)))
    if depth + 1 > MAX_DEPTH:
        fail("%s: a flow may include a block, and a block one more - '%s' is "
             "deeper than that: %s" % (at, name, " -> ".join(trail)))
    with_ = step.get("with", {})
    if not isinstance(with_, dict):
        fail('%s: "with" is an object of name/value pairs, for instance '
             '{"TEST_EMAIL": "beth@example.com"}' % at)
    # The values a block is called with are read in the scope of the caller, so
    # an include can pass an environment variable on, or one of its own
    # parameters. Inside the block they shadow the environment, and only there.
    inner = dict(scope)
    for key in sorted(with_):
        v = with_[key]
        if not NAME.match(key):
            fail("%s: '%s' cannot be the name of a parameter - letters, digits "
                 "and _, not starting with a digit" % (at, key))
        if v is None or isinstance(v, (dict, list, bool)):
            fail("%s: parameter '%s' must be text or a number" % (at, key))
        v = v if isinstance(v, str) else str(v)
        inner[key] = fill(v, scope, at, bool(src))
    build(path, "block '%s'" % name, name, inner, chain + [(real, name)],
          depth + 1, "%s: " % at)

flow = sys.argv[1]
build(flow, "flow file", "", dict(os.environ),
      [(os.path.realpath(flow), os.path.basename(flow))], 0)

sys.stdout.write(END.join(recs) + (END if recs else ""))
PY
  then gmsg="$(cat "$gerr")"; rm -f "$steps" "$gerr"; die "${gmsg:-the flow file could not be read}"; fi
  rm -f "$gerr"
  # Opened and then unlinked: the loop keeps reading it, and no path is left
  # behind whichever way the flow ends.
  exec 3< "$steps"; rm -f "$steps"
  # The steps are fed on FD 3, NOT stdin: steps shell out to adb/idb,
  # and `adb shell` / subprocesses read stdin — if the loop read from the same
  # pipe they'd swallow the remaining steps, so only step 1 ran (and the flow
  # still reported PASS). Reading `<&3` also keeps the loop in THIS shell (not a
  # pipe subshell), so a step's `die` (exit 1) aborts the whole flow with a
  # non-zero status instead of being lost.
  while IFS=$'\x1f' read -r -d '' do_ val x y mtch tmo dir edg src sidx wcond wspan bspec ttl <&3; do
      # A guard is not a step: it takes no number of its own, and when it holds
      # the run says nothing about it - the steps that follow simply run. When it
      # does not hold, its whole group is read off the stream and every step in it
      # is recorded as skipped.
      if [ "$do_" = "__when" ]; then
        if [ -n "$src" ]; then export YUKTI_STEP_SRC="block '$src', step $sidx"
        else export YUKTI_STEP_SRC="step $sidx of this flow file"; fi
        # Answering a condition means reading the screen. --check has none, and
        # skipping the group would leave the steps inside it unchecked - the
        # steps most likely to be stale, because a condition is what keeps them
        # off most runs.
        if [ "$chk" = 1 ]; then continue; fi
        if cond_holds "$wcond"; then continue; fi
        flow_skip "${wspan:-1}" "$(cond_words "$wcond")"
        continue
      fi
      # Record the step BEFORE running it and again once it survived: the one
      # step that has a start and no end is the step that failed, and that is
      # the single fact a report cannot reconstruct from console text.
      FLOW_IDX=$((FLOW_IDX+1)); FLOW_S0="$(now)"; FLOW_ART=""
      # The number the run counts and the number the author has to look for are
      # the same file only while a flow has no includes. Once it has one, step 4
      # of the run can be step 2 of the block, or step 2 of the flow file after
      # a block of three - so a failure says which file and which step in it,
      # and says nothing extra when the two numbers agree.
      if [ -n "$src" ]; then export YUKTI_STEP_SRC="block '$src', step $sidx"
      elif [ "$sidx" != "$FLOW_IDX" ]; then export YUKTI_STEP_SRC="step $sidx of this flow file"
      else export YUKTI_STEP_SRC=""; fi
      if [ "$chk" = 0 ]; then
        printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$FLOW_IDX" "$do_" "${val//[$'\n\r']/ }" "$FLOW_S0" "${src//[$'\n\r']/ }" "$ttl" > "$FLOW_CUR"
        : > "$FLOW_ERR"
      fi
      # The name first, the keys after it, because the order decides what a typo
      # hears. A step named `tpText` carrying a `match` would otherwise be told
      # that `tpText` does not take the key - a message that asserts the verb
      # exists and costs the author a second run to find the real mistake.
      case " $FLOW_VERBS " in *" $do_ "*) ;; *) die "unknown step '$do_' - check the flow file";; esac
      # `match` belongs to the assertion contract, so only the verb that reads
      # it may be given it. A locator that ignored the key told the flow author
      # it was honoured: tapText folds case and matches a substring whatever the
      # step says, and a suite written on that belief is weaker than it reads.
      [ -z "$mtch" ] || case "$do_" in assertText|assertNotText|waitFor) ;; *) die "step $FLOW_IDX '$do_' does not take a \"match\" - only assertText, assertNotText and waitFor do";; esac
      # Same rule for the two keys scrollToText reads: a key a step ignores is a
      # line of the flow file that does not do what it says. `scroll` carries its
      # direction in "value", the way it always has.
      [ -z "$dir" ] || case "$do_" in scrollToText) ;; *) die "step $FLOW_IDX '$do_' does not take a \"direction\" - only scrollToText does; scroll takes its direction as its \"value\"";; esac
      [ -z "$edg" ] || case "$do_" in scrollToText) ;; *) die "step $FLOW_IDX '$do_' does not take an \"edges\" - only scrollToText does";; esac
      # Same rule, the other way round: hideKeyboard closes whatever keyboard is
      # up and has nothing to read a value with. Carrying one means the author
      # meant pressKey, and a key silently ignored is a flow that believes it
      # pressed something.
      case "$do_" in hideKeyboard) [ -z "$val" ] || die "step $FLOW_IDX 'hideKeyboard' does not take a \"value\" - it closes whatever keyboard is up; to press a named key use pressKey";; esac
      # Everything above this line is answerable without a device. Everything
      # below it touches one.
      if [ "$chk" = 1 ]; then continue; fi
      # A step with a title says so before it runs: the lines the step prints
      # itself name what it touched, the title names what it was for.
      [ -z "$ttl" ] || say "step $FLOW_IDX '$do_' \"$ttl\""
      set +e   # a step must not abort the loop by itself: the status is read
               # right after the dispatcher, so the failure is attributed to
               # THIS step and the flow stops with a message.
      case "$do_" in
        wait)        wait_s "${val:-2}";;
        waitFor)     wait_for "$val" "${tmo:-10}" "${mtch:-exact}" assert;;
        waitForId)   wait_for "$val" "${tmo:-10}" exact id;;
        # shot runs in a substitution, so its own die kills only that subshell:
        # the step used to report PASS with an empty path, whether the name was
        # refused or screencap itself failed. The status has to be checked here,
        # in the shell that can stop the flow.
        screenshot)  FLOW_ART="$(shot "$val")" || die "screenshot failed"
                     [ -n "$FLOW_ART" ] || die "screenshot produced no file"
                     ok "shot → $FLOW_ART";;
        tap)         tap $(scale_xy "$x" "$y");;
        tapText)     say "tap '$val'"; tap_text "$val";;
        optionalTapText) tap_text_optional "$val";;
        scroll)      scroll_step "${val:-down}";;
        scrollToText) scroll_to_step "$val" "${dir:-down}" "$edg" >/dev/null;;
        dismiss)     dismiss;;
        clearText)   clear_field $(scale_xy "$x" "$y");;
        clearTextId) say "clear id '$val'"; clear_id "$val";;
        pressKey)    press_key "$val";;
        hideKeyboard) hide_keyboard;;
        type)        say "type ${#val} chars"; type_str "$val";;
        assertText)  assert_text "$val" "${mtch:-exact}";;
        assertNotText) assert_not_text "$val" "${mtch:-exact}";;
        assertNotId) assert_not_id "$val";;
        tapId)       say "tap id '$val'"; tap_id "$val";;
        assertId)    assert_id "$val";;
        assertBox)   assert_box "$val" assert "$bspec";;
        assertBoxId) assert_box "$val" id "$bspec";;
        launch)      launch "$val";;
        stopApp)     stop_app "$val";;
        clearState)  clear_state "$val";;
        openUrl)     open_url "$val";;
        # A name the dispatcher does not know is a typo in the flow file, and a
        # typo must not pass: `warn` returns zero, so this case has to die on its
        # own - reading the status below would not catch it.
        *) die "unknown step '$do_' - check the flow file";;
      esac
      st=$?
      # A step that failed without dying used to be recorded as passed: the
      # status of the dispatcher was never read. `adb` refusing a tap, a launch
      # of a package that is not installed, a clearText on a dead device - all
      # reported PASS, and the JUnit file said failures="0". Only an explicit
      # `die` could stop a flow.
      #
      # The two best-effort verbs stay the exception, by contract: they return
      # non-zero when a label is simply absent, which is the state they exist
      # to tolerate.
      case "$do_" in dismiss|optionalTapText) st=0;; esac
      [ "$st" -eq 0 ] || die "step $FLOW_IDX '$do_'${ttl:+ \"$ttl\"} failed (exit $st)"
      # The eighth field is the block the step was written in, empty for the flow
      # file itself; the seventh stays empty, because this step ran. The ninth is
      # the step's title, empty when it has none.
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f\x1f%s\x1f%s\n' "$FLOW_IDX" "$do_" "${val//[$'\n\r']/ }" "$FLOW_S0" "$(now)" "$FLOW_ART" "${src//[$'\n\r']/ }" "$ttl" >> "$FLOW_REC"
  done
  exec 3<&-
  export YUKTI_STEP_SRC=""
  if [ "$chk" = 1 ]; then ok "flow checks out: $f - $FLOW_IDX steps"; else ok "flow complete: $f"; fi
}

