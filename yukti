#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# yukti — a portable local iOS-Simulator QA rig for React Native / Expo apps.
#
#   build → sign → boot → install → launch → drive.  No cloud device farm.
#
# Two ways to run tests, and AI is OPTIONAL:
#   • Deterministic flows   →  `yukti flow flows/login.json`   (zero AI, CI-ready)
#   • AI-driven exploration →  any agent (Claude Code / OpenAI computer-use)
#                              drives the primitives below (shot/ui/find/tap/type)
#
# The whole rig is Apple tools + idb. Expo/EAS is an optional adapter, not a dep.
#
# MIT licensed. https://github.com/<you>/yukti
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

YUKTI_VERSION="0.1.0"
CONFIG="${YUKTI_CONFIG:-yukti.config.json}"
PY="/usr/bin/python3"                       # system python: reliable expat + json
NODE22="/opt/homebrew/opt/node@22/bin"      # RN/Metro pins node 22; sys node may be broken
IDB_BIN="$HOME/Library/Python/3.9/bin"      # fb-idb CLI install location

# ── pretty ───────────────────────────────────────────────────────────────────
c(){ printf '\033[%sm' "$1"; }; R=$(c 0); B=$(c '1;36'); G=$(c '1;32'); Y=$(c '1;33'); E=$(c '1;31')
say(){ printf '%s▸%s %s\n' "$B" "$R" "$*"; }
ok(){  printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn(){ printf '%s!%s %s\n' "$Y" "$R" "$*"; }
die(){ printf '%s✗%s %s\n' "$E" "$R" "$*" >&2; exit 1; }

need_config(){ [ -f "$CONFIG" ] || die "no config at '$CONFIG' — run 'yukti init' or set YUKTI_CONFIG"; }

# ── config reader (dotted path; prints scalars raw, lists/objects as JSON) ─────
cfg(){ need_config; "$PY" - "$CONFIG" "$1" "${2:-}" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); default=sys.argv[3] if len(sys.argv)>3 else ""
cur=d
try:
    for k in sys.argv[2].split('.'):
        cur=cur[k]
except (KeyError,TypeError):
    print(default); sys.exit(0)
print(cur if not isinstance(cur,(list,dict)) else json.dumps(cur))
PY
}

app_dir(){ ROOT="$(cfg projectRoot .)"; cd "$ROOT" 2>/dev/null || die "projectRoot '$ROOT' not found"; }
paths(){ export PATH="$NODE22:$IDB_BIN:/opt/homebrew/bin:$PATH"; }
udid_file(){ echo "${TMPDIR:-/tmp}/yukti-udid"; }
booted(){ xcrun simctl list devices 2>/dev/null | grep -m1 Booted | grep -oE '[0-9A-F-]{36}' || true; }
plat_of(){ cfg "variants.$1.platform" ios; }

# ── Android backend (adb + uiautomator + gradle) ─────────────────────────────
# 1:1 mirror of the iOS path. Implemented; validate on a Mac with the Android SDK.
# Android debug APKs are auto-signed with the debug key — none of the iOS signing/
# keychain/arch pain applies. Config per variant: platform:"android", package,
# gradleTask (default assembleDebug); global android.avd for the emulator.
ANDROID_SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
apaths(){ export PATH="$NODE22:$ANDROID_SDK/platform-tools:$ANDROID_SDK/emulator:$ANDROID_SDK/cmdline-tools/latest/bin:/opt/homebrew/bin:$PATH"; }

build_android(){ local V="$1"; app_dir; apaths
  local task apk env; task="$(cfg variants.$V.gradleTask assembleDebug)"; env="$(cfg variants.$V.envFile)"
  [ -n "$env" ] && [ -f "$env" ] && cp "$env" .env.local && ok "env: $env → .env.local"
  say "gradle $task"; ( cd android && ./gradlew "$task" ) || die "gradle build failed"
  apk="$(find android/app/build/outputs/apk -name '*.apk' 2>/dev/null | head -1)"
  [ -n "$apk" ] || die "no APK produced"; echo "$apk" > "${TMPDIR:-/tmp}/yukti-apk-$V"; ok "built: $apk"; }
boot_android(){ apaths; local avd; avd="$(cfg android.avd Pixel_7_API_34)"
  if ! adb devices 2>/dev/null | grep -q emulator; then say "starting emulator $avd"; ( "$ANDROID_SDK/emulator/emulator" -avd "$avd" -no-boot-anim >/dev/null 2>&1 & ); fi
  adb wait-for-device; until [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; do sleep 2; done; ok "emulator booted"; }
install_android(){ apaths; local V="$1"; adb install -r "$(cat "${TMPDIR:-/tmp}/yukti-apk-$V")" && ok "installed"; }
launch_android(){ apaths; local pkg; pkg="$(cfg variants.$1.package)"; adb shell monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 && ok "launched $pkg"; }
ashot(){ apaths; local o="${1:-${TMPDIR:-/tmp}/yukti-shot.png}"; adb exec-out screencap -p > "$o" && echo "$o"; }
# Delete the dump before writing a new one. uiautomator refuses to dump while the
# screen is animating ("could not get idle state!"), the error was swallowed, and
# `cat` then served the tree of the PREVIOUS call: the next assert checked the
# previous screen and passed. An empty or missing file is now a failure, not a
# tree. A refusal is a normal state right after a tap, so retry a few times the
# way the iOS ui() already does, and only then give up. Remove, dump and read run
# in ONE adb round trip: a lookup used to cost two, a scroll_to up to eighteen.
aui(){ apaths; local xml i
  for i in 1 2 3; do
    xml="$(adb shell 'rm -f /sdcard/yk.xml; uiautomator dump /sdcard/yk.xml >/dev/null 2>&1; cat /sdcard/yk.xml' 2>/dev/null)"
    [ -n "$xml" ] && { printf '%s' "$xml"; return 0; }
    [ "$i" = 3 ] || sleep 0.6
  done
  die "uiautomator produced no dump after 3 tries - the screen may still be animating"; }
afind(){ apaths; aui | "$PY" -c '
import sys,re,html
# Rank candidates instead of taking the first substring hit. Honors resource-id
# and prefers the interactive field over a nearby static caption — "Email" used
# to hit the "or use email" caption ~100px above the input, and "Password" hit
# the "Forgot Password?" link. A node now must be relevant (query appears in its
# text / content-desc / resource-id) AND scores highest to win; an editable /
# clickable / focusable node outranks a plain caption.
# mode="id": explicit selector. The resource-id segment must match EXACTLY and
# nothing else is considered — a flow that asks for an id gets that element or fails.
# Whitespace is normalised on both sides. unescape turns &#10; into a real line
# break, and a two-line caption would otherwise be assertable only by writing the
# line break into the flow file.
norm=lambda s: " ".join(s.split())
q=norm(sys.argv[1].lower()); mode=(sys.argv[2] if len(sys.argv)>2 else "text")
xml=sys.stdin.read()
# Screen rect = the bounds of the ROOT node, i.e. the first bounds= in the dump.
# Anything whose centre falls outside it is scrolled away or parked off-screen:
# present in the tree, invisible to the user. Taking the maximum over every node
# instead would let a node larger than the viewport widen the rect - and the rows
# scrolled out of a list are exactly the ones that report such bounds, so the
# filter would loosen on the screens it was written for.
SX1=SY1=SX2=SY2=0
_m=re.search(r"bounds=\"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]\"", xml)
if _m: SX1,SY1,SX2,SY2=map(int,_m.groups())
# No usable screen rect means the off-screen filter cannot run. A tap may still be
# worth attempting, but a check that cannot check must not report success - and
# assertId is as much an oracle as assertText. tapId loses nothing by it: it does
# not scroll, and a tap outside the window is useless anyway.
if mode in ("assert","id") and not (SX2>SX1 and SY2>SY1): sys.exit(0)
best=None; best_score=0
for m in re.finditer(r"<node\b[^>]*>", xml):
    tag=m.group(0)
    def a(n):
        # uiautomator escapes &, <, > and the quote characters. Unescaped,
        # assertText "Terms & Conditions" fails on the very screen that shows it,
        # and assertText "amp" passes on any screen with an ampersand - markup
        # matching through the back door.
        mm=re.search(n+r"=\"([^\"]*)\"",tag); return norm(html.unescape(mm.group(1))) if mm else ""
    text=a("text").lower(); desc=a("content-desc").lower()
    rid=a("resource-id"); rid_seg=rid.split("/")[-1].lower()  # com.app:id/email -> email
    cls=a("class"); editable=cls.endswith("EditText")
    clickable=a("clickable")=="true"; focusable=a("focusable")=="true"
    if mode=="id":
        # An empty query must match nothing. The flow runner passes value="" for a
        # missing or misspelled key, and "" is the resource-id of most nodes: the
        # step would then report success and tapId would tap an arbitrary point.
        if not q or q!=rid_seg: continue
        score=10
    elif mode=="assert":
        # An assertion is the test oracle: it may only match what a person can
        # perceive - visible text or the accessibility label. Matching a
        # resource-id, a class name or an attribute lets a step pass on markup.
        if not (q and (q in text or q in desc)): continue
        score=10
    else:
        if not (q and (q in rid_seg or q in text or q in desc)): continue
        score=0
        if q==rid_seg: score+=6
        elif q in rid_seg: score+=5
        if q==text or q==desc: score+=4
        elif q in text or q in desc: score+=2
        if editable: score+=3
        if clickable: score+=1
        if focusable: score+=1
    if score<=best_score: continue
    b=re.search(r"bounds=\"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]\"",tag)
    if not b: continue
    x1,y1,x2,y2=map(int,b.groups())
    if not (x2>x1 and y2>y1): continue   # zero-area node: in the tree, not on the screen
    cx,cy=(x1+x2)//2,(y1+y2)//2
    if SX2>SX1 and SY2>SY1 and not (SX1<=cx<SX2 and SY1<=cy<SY2): continue  # off-screen
    best=(cx,cy); best_score=score
if best: print(best[0],best[1])
' "$1" "${2:-text}"; }
atap(){ apaths; adb shell input tap "$1" "$2"; }
atype(){ apaths; local s="$1" q
  # Quote for the ON-DEVICE shell so metacharacters can't expand. Unquoted, a *
  # in a password was glob-expanded by /system/bin/sh (an 8-char password
  # arrived as 11 chars). Single-quote the arg (escaping embedded ' as '\''),
  # then map spaces to %s which `input text` turns back into spaces.
  q=$(printf '%s' "$s" | sed "s/'/'\\\\''/g")
  q=${q// /%s}
  adb shell "input text '$q'"; }
aclear(){ apaths; adb shell input tap "$1" "$2"; local i; for i in $(seq 1 40); do adb shell input keyevent 67 >/dev/null 2>&1; done; }

# ── doctor: verify/report the toolchain ──────────────────────────────────────
doctor(){
  paths; local bad=0
  say "yukti v$YUKTI_VERSION — environment check"
  if xcrun simctl help >/dev/null 2>&1; then ok "Xcode + simctl"; else die "Full Xcode required (not just CLT). Install Xcode, then: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"; fi
  xcrun simctl list runtimes 2>/dev/null | grep -qi ios && ok "iOS simulator runtime" || { warn "no iOS runtime — installing"; xcodebuild -downloadPlatform iOS; }
  command -v node >/dev/null && ok "node $(node -v)" || { warn "node@22 missing"; bad=1; echo "   brew install node@22"; }
  command -v pod  >/dev/null && ok "cocoapods $(pod --version)" || { warn "cocoapods missing"; bad=1; echo "   brew install cocoapods"; }
  command -v idb  >/dev/null && ok "idb (UI driver)" || { warn "idb missing"; bad=1; echo "   brew trust facebook/fb && brew install idb-companion && $PY -m pip install --user fb-idb"; }
  [ "$(cfg easEnabled false)" = "True" -o "$(cfg easEnabled false)" = "true" ] && { command -v npx >/dev/null && ok "npx (for EAS adapter)"; }
  [ $bad -eq 0 ] && ok "ready" || die "install the tools above, then re-run 'yukti doctor'"
}

# ── device-only-lib scan: static frameworks lacking an arm64-simulator slice ──
# (These break arm64 sim linking; exclude them from iOS autolinking for the rig.)
scan(){
  app_dir; say "scanning ios/Pods for device-only frameworks (no arm64-sim slice)…"
  find ios/Pods -type f -path "*.framework/*" ! -path "*.xcframework/*" 2>/dev/null | while read -r f; do
    file "$f" 2>/dev/null | grep -q "Mach-O" || continue
    lipo -info "$f" 2>/dev/null | grep -q arm64 || continue
    vtool -show-build "$f" 2>/dev/null | grep -qi SIMULATOR || echo "  device-only: $(echo "$f" | sed -E 's#.*/Pods/([^/]+)/.*#\1#')"
  done | sort -u
  warn "add the npm packages that vendor these to config .excludeIosAutolink[]"
}

# ── write react-native.config.js to drop device-only libs from iOS autolinking ─
write_rn_excludes(){
  app_dir; local ex; ex="$(cfg excludeIosAutolink '[]')"
  [ "$ex" = "[]" ] && return 0
  [ -f react-native.config.js ] && [ ! -f .yukti.rnconfig.bak ] && cp react-native.config.js .yukti.rnconfig.bak
  "$PY" - "$ex" > react-native.config.js <<'PY'
import json,sys
pkgs=json.loads(sys.argv[1])
deps=",\n".join(f"    {json.dumps(p)}: {{ platforms: {{ ios: null }} }}" for p in pkgs)
print("// AUTO-GENERATED by yukti — device-only libs w/o arm64-sim slice, excluded for sim builds.\n"
      "module.exports = {\n  dependencies: {\n"+deps+"\n  },\n};")
PY
  ok "react-native.config.js excludes: $(echo "$ex" | "$PY" -c 'import json,sys;print(", ".join(json.load(sys.stdin)))')"
}

# ── build a signed arm64 simulator .app for a variant ────────────────────────
build(){
  local V="${1:?usage: yukti build <variant>}"
  [ "$(plat_of "$V")" = android ] && { build_android "$V"; return; }
  app_dir; paths
  local scheme cfgn env dd
  scheme="$(cfg variants.$V.scheme)";        [ -n "$scheme" ] || die "unknown variant '$V'"
  cfgn="$(cfg variants.$V.configuration)"
  env="$(cfg variants.$V.envFile)"
  dd="ios/.yukti-build/$V"
  say "building '$V'  (scheme='$scheme' config='$cfgn')"
  [ -n "$env" ] && [ -f "$env" ] && cp "$env" .env.local && ok "env: $env → .env.local" || warn "no envFile for '$V' (config .variants.$V.envFile)"
  write_rn_excludes
  ( cd ios && pod install >/dev/null 2>&1 ) && ok "pods installed"
  local appvar; appvar="$(cfg variants.$V.appVariant "$V")"
  NODE_ENV="$(cfg variants.$V.nodeEnv development)" APP_VARIANT="$appvar" EXPO_VARIANT_EXPLICIT=1 \
  xcodebuild -workspace "$(cfg workspace)" -scheme "$scheme" -configuration "$cfgn" \
    -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath "$dd" \
    ARCHS=arm64 ONLY_ACTIVE_ARCH=NO EXCLUDED_ARCHS=x86_64 \
    CODE_SIGN_IDENTITY="-" CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM="" PROVISIONING_PROFILE_SPECIFIER="" \
    build >/dev/null || die "xcodebuild failed — run without >/dev/null to see errors, or 'yukti scan' for device-only libs"
  # NB: ad-hoc CODE_SIGN_IDENTITY="-" keeps entitlements (keychain) so Firebase/auth works.
  #     CODE_SIGNING_ALLOWED=NO would strip them → -34018 keychain → login 401s.
  local app; app="$(find "$dd/Build/Products" -maxdepth 2 -name '*.app' | head -1)"
  [ -n "$app" ] || die "build produced no .app"
  echo "$app" > "${TMPDIR:-/tmp}/yukti-app-$V"
  ok "built: $app"
}

# ── pull an OFFICIAL simulator build from EAS (optional adapter) ──────────────
pull_eas(){
  local V="${1:?usage: yukti pull <variant>}"; app_dir; paths
  [ -f /tmp/expotoken ] || [ -n "${EXPO_TOKEN:-}" ] || die "set EXPO_TOKEN (or /tmp/expotoken) for the EAS adapter"
  local tok profile; tok="${EXPO_TOKEN:-$(cat /tmp/expotoken)}"; profile="$(cfg variants.$V.easProfile simulator)"
  say "triggering EAS simulator build (profile='$profile') — cloud, ~15 min"
  EXPO_TOKEN="$tok" npx eas-cli build --platform ios --profile "$profile" --non-interactive --wait || die "eas build failed (does eas.json have a '$profile' profile with ios.simulator=true?)"
  local url; url="$(EXPO_TOKEN="$tok" npx eas-cli build:list --platform ios --limit 1 --json --non-interactive 2>/dev/null | "$PY" -c 'import json,sys;print(json.load(sys.stdin)[0]["artifacts"]["applicationArchiveUrl"])')"
  say "downloading $url"; curl -sL "$url" -o /tmp/yukti-eas.tar.gz
  local out="ios/.yukti-build/eas-$V"; rm -rf "$out"; mkdir -p "$out"; tar -xzf /tmp/yukti-eas.tar.gz -C "$out"
  local app; app="$(find "$out" -maxdepth 2 -name '*.app' | head -1)"
  [ -n "$app" ] || die "EAS archive had no .app (was it a device .ipa? need a simulator profile)"
  echo "$app" > "${TMPDIR:-/tmp}/yukti-app-$V"; ok "pulled: $app"
}

# ── simulator lifecycle ──────────────────────────────────────────────────────
boot(){
  [ "${YUKTI_PLATFORM:-ios}" = android ] && { boot_android; return; }
  paths; local dev rt u
  dev="$(cfg simulator.device 'iPhone 16 Pro')"
  u="$(xcrun simctl list devices | grep -m1 "$dev (" | grep -oE '[0-9A-F-]{36}' || true)"
  if [ -z "$u" ]; then
    rt="$(xcrun simctl list runtimes | grep -i ios | grep -oE 'com.apple.CoreSimulator.SimRuntime.iOS[^ ]*' | tail -1)"
    local dt; dt="$(xcrun simctl list devicetypes | grep -oE "com.apple.CoreSimulator.SimDeviceType.$(echo "$dev" | tr ' ' '-')" | head -1)"
    u="$(xcrun simctl create "yukti-$dev" "$dt" "$rt")"; ok "created $dev"
  fi
  xcrun simctl boot "$u" 2>/dev/null || true
  xcrun simctl bootstatus "$u" -b >/dev/null 2>&1 || true
  open -a Simulator
  echo "$u" > "$(udid_file)"; ok "booted $dev ($u)"
}
install(){ local V="${1:?variant}"; [ "$(plat_of "$V")" = android ] && { install_android "$V"; return; }; paths; local u a; u="$(cat "$(udid_file)")"; a="$(cat "${TMPDIR:-/tmp}/yukti-app-$V")"
  xcrun simctl install "$u" "$a" && ok "installed $(basename "$a")"; }
launch(){ local V="${1:?variant}"; [ "$(plat_of "$V")" = android ] && { launch_android "$V"; return; }; paths; local u b; u="$(cat "$(udid_file)")"; b="$(cfg variants.$V.bundleId)"
  xcrun simctl launch "$u" "$b" && ok "launched $b"; }
up(){ local V="${1:?usage: yukti up <variant>}"; export YUKTI_PLATFORM="$(plat_of "$V")"; build "$V"; boot; install "$V"; launch "$V"; ok "up: '$V' running — drive with 'yukti shot' / 'yukti flow'"; }

# ── drive primitives (used by flows AND by AI agents) ────────────────────────
U(){ cat "$(udid_file)" 2>/dev/null || booted; }
idb_ready(){ paths; idb connect "$(U)" >/dev/null 2>&1 || true; }
shot(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { ashot "$@"; return; }; paths; xcrun simctl io "$(U)" screenshot "${1:-${TMPDIR:-/tmp}/yukti-shot.png}" >/dev/null 2>&1 && echo "${1:-${TMPDIR:-/tmp}/yukti-shot.png}"; }
ui(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { aui; return; }; idb_ready; local u out i; u="$(U)"; for i in 1 2 3 4; do out="$(idb ui describe-all --udid "$u" 2>/dev/null)"; [ -n "$out" ] && { printf '%s' "$out"; return 0; }; sleep 0.6; done
  # An empty tree after four tries is idb failing, not a screen with nothing on
  # it: a booted simulator always reports at least its window. Returning the
  # empty string made every caller read it as "the element is not there". The
  # Android path already fails here; this is the same rule for iOS.
  die "idb returned no accessibility tree after 4 tries - is the simulator booted?"; }
find_el(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { afind "$1" "${2:-text}"; return; }; paths; ui | "$PY" -c '
import json,sys
# Rank candidates instead of the first AXLabel/AXValue substring hit: honor the
# accessibility identifier (AXUniqueId) and prefer the actual field/control over
# a nearby static caption — same bug the Android path had ("Email" hit the "or
# use email" caption; "Password" hit the "Forgot Password?" link).
norm=lambda s: " ".join(s.split())   # a two-line caption is one query with spaces
q=norm(sys.argv[1].lower()); mode=(sys.argv[2] if len(sys.argv)>2 else "text")
raw=sys.stdin.read().strip()
if not raw: sys.exit(0)
els=json.loads(raw)
def frame(e):
    # idb builds disagree on the case of the frame keys, so read both spellings.
    b=e.get("frame") or {}
    def n(*ks):
        for k in ks:
            v=b.get(k)
            if v is None: continue
            try: return float(v)
            except (TypeError,ValueError): return 0.0
        return 0.0
    return n("X","x"),n("Y","y"),n("Width","width"),n("Height","height")
# Screen rect = the window: the element idb names as the application or a window
# if there is one, else the largest frame on screen. Application is larger than
# any of its children by construction, and an iOS scroll view reports the visible
# part rather than its content, so the maximum is the window on lists too. Taking
# the FIRST framed element instead would rest on the order of a flat list, which
# idb does not promise - an alert, an overlay or the keyboard window can come
# first and shrink the rect to its own size. The Android path can rely on order
# because the dump format puts the root node first; here that guarantee is absent.
SX=SY=SW=SH=0.0; _best=(0,-1.0)
for _e in els:
    _x,_y,_w,_h=frame(_e)
    if not (_w>0 and _h>0): continue
    _t=(str(_e.get("type") or "")+" "+str(_e.get("role_description") or "")).lower()
    _rank=(1 if ("application" in _t or "window" in _t) else 0, _w*_h)
    if _rank>_best: _best=_rank; SX,SY,SW,SH=_x,_y,_w,_h
def centre(e):
    # The tap point, or None when the element is not really on screen: a11y reports
    # elements with no size and elements parked outside the window, and a check that
    # accepts them is not a check.
    x,y,w,h=frame(e)
    if not (w>0 and h>0): return None
    cx=int(x+w/2); cy=int(y+h/2)
    if SW>0 and SH>0 and not (SX<=cx<SX+SW and SY<=cy<SY+SH): return None
    return cx,cy
# Same reason as the Android path, assertId included. Note the limit of the rect
# itself: when no element is named application or window, the largest frame wins
# and it always contains itself, so on such an idb build the off-screen filter
# stops discriminating. Requiring a named window here would fail closed on every
# build that names none, which cannot be verified without a Mac.
if mode in ("assert","id") and not (SW>0 and SH>0): sys.exit(0)
best=None; best_score=-1
for e in els:
    label=norm(str(e.get("AXLabel") or "").lower())
    value=norm(str(e.get("AXValue") or "").lower())
    title=norm(str(e.get("title") or "").lower())
    ident=str(e.get("AXUniqueId") or e.get("identifier") or "").lower()
    t=(str(e.get("type") or "")+" "+str(e.get("role_description") or "")).lower()
    editable=("textfield" in t) or ("securetext" in t) or ("text field" in t) or ("textview" in t)
    control=("button" in t) or ("link" in t)
    if mode=="id":
        # Explicit selector: the accessibility identifier must match exactly, and an
        # empty query matches nothing - the flow runner passes value="" for a missing
        # or misspelled key, and that must not resolve to the first element around.
        if not q or q!=ident: continue
        xy=centre(e)
        if xy is None: continue   # keep looking: a sized namesake may follow
        print(xy[0],xy[1]); sys.exit(0)
    if mode=="assert":
        # See the Android path: an assertion matches perceivable text only, on an
        # element that is really on screen - real size, centre inside the window.
        if not (q and (q in label or q in value or q in title)): continue
        xy=centre(e)
        if xy is None: continue
        print(xy[0],xy[1]); sys.exit(0)
    if not (q and (q in ident or q in label or q in value or q in title)): continue
    score=0
    if q==ident: score+=6
    elif q in ident: score+=5
    if q in (label,value,title): score+=4
    elif q in label or q in value or q in title: score+=2
    if editable: score+=3
    if control: score+=1
    x,y,w,h=frame(e)
    # A zero-size element cannot be tapped: a hidden namesake used to win the
    # ranking and send the tap to (0,0). Off-screen elements stay eligible here -
    # scroll_to needs their coordinates to know which way to scroll - but a
    # candidate that is actually on screen outranks one that is not, so a namesake
    # further down a list can no longer take the tap away from the visible one.
    if not (w>0 and h>0): continue
    if centre(e) is not None: score+=2
    if score<=best_score: continue
    best=(int(x+w/2),int(y+h/2)); best_score=score
if best: print(best[0],best[1])
' "$1" "${2:-text}"; }
tap(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { atap "$1" "$2"; return; }; paths; idb ui tap --udid "$(U)" "${1:?x}" "${2:?y}"; }
# A lookup has three outcomes, not two: coordinates, "no such element", and
# "the screen could not be read at all". The third one used to arrive as the
# second, because `die` inside aui/ui exits a command-substitution subshell and
# the status was dropped. A flow then skipped an optionalTapText, swiped eight
# times looking for a label, or blamed a missing element for a broken dump.
# Every lookup below now checks the status: an unreadable screen stops the run.
tap_text(){ local xy; xy="$(scroll_to "$1")" || die "cannot read the screen - see the error above"; [ -n "$xy" ] || die "no element matching '$1'"; tap $xy; }  # auto-scrolls off-screen elements into view
tap_text_optional(){ local xy; xy="$(find_el "$1")" || die "cannot read the screen - see the error above"; [ -n "$xy" ] && { tap $xy; ok "optional tap '$1'"; } || warn "optional '$1' not present — skipped"; }
# Auto-dismiss the interstitials that derail flows (Save Password, notifications, promos…)
dismiss(){ local L xy; for L in "Not Now" "Not now" "Maybe Later" "Later" "Skip for now" "Skip" "No thanks" "No Thanks" "Got it"; do
    xy="$(find_el "$L")" || die "cannot read the screen - see the error above"
    [ -n "$xy" ] && { tap $xy; sleep 0.6; ok "dismissed '$L'"; }
  done; }  # only SAFE interstitial labels — never Cancel/Close/OK (those navigate/confirm)
type_str(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { atype "$1"; return; }; paths; local s="${1:?text}" i; for ((i=0;i<${#s};i++)); do idb ui text --udid "$(U)" "${s:$i:1}" >/dev/null 2>&1; sleep 0.12; done; }  # char-by-char = reliable
clear_field(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { aclear "$1" "$2"; return; }; paths; local x="${1:?x}" y="${2:?y}" i; idb ui tap --udid "$(U)" "$x" "$y"; sleep .4; idb ui tap --udid "$(U)" 360 "$y"; sleep .3; for i in $(seq 1 32); do idb ui key --udid "$(U)" 42 >/dev/null 2>&1; done; }
# An assert must prove the element is ON SCREEN, not that the string appears
# somewhere in the dump. `ui | grep` matched invisible nodes, off-screen rows and
# attribute values, so an assertText passed on a screen that never opened. Reuse
# the same lookup taps use: relevance, ranking and real non-zero bounds.
assert_text(){ local xy; xy="$(find_el "$1" assert)" || die "assert FAILED: cannot read the screen - see the error above"; [ -n "$xy" ] && ok "assert: '$1' on screen at $xy" || die "assert FAILED: '$1' not on screen"; }
# Explicit-selector variants. tapText/assertText match on visible text and can
# land on a neighbouring caption; these two take an accessibility id / resource-id
# segment and match it exactly, or fail. An empty id is a failure, never a match:
# a flow step with a missing or misspelled `value` must stop the run, not tap a
# random point. Neither scrolls — use scrollToText first for a target below the fold.
tap_id(){ local q="${1:-}"; [ -n "$q" ] || die "tapId needs a non-empty id"; local xy; xy="$(find_el "$q" id)" || die "cannot read the screen - see the error above"; [ -n "$xy" ] || die "no element with id '$q'"; tap $xy; }
assert_id(){ local q="${1:-}"; [ -n "$q" ] || die "assertId needs a non-empty id"; local xy; xy="$(find_el "$q" id)" || die "assert FAILED: cannot read the screen - see the error above"; [ -n "$xy" ] && ok "assert id: '$q' on screen at $xy" || die "assert FAILED: no element with id '$q'"; }
wait_s(){ sleep "${1:-2}"; }
scroll(){ [ "${YUKTI_PLATFORM:-ios}" = android ] && { apaths; if [ "${1:-down}" = up ]; then adb shell input swipe 200 300 200 700 300; else adb shell input swipe 200 700 200 300 300; fi; return; }
  paths; if [ "${1:-down}" = up ]; then idb ui swipe --udid "$(U)" 200 320 200 720; else idb ui swipe --udid "$(U)" 200 720 200 320; fi; }
# a11y reports FULL-CONTENT coords; taps need ON-SCREEN coords. Scroll a label into the viewport.
# Stop on an unreadable screen instead of swiping eight times into the dark:
# a swipe changes state, and the state is what the next step is checking.
scroll_to(){ local lbl="$1" i xy y; for i in $(seq 1 8); do xy="$(find_el "$lbl")" || die "cannot read the screen - see the error above"
    if [ -n "$xy" ]; then y="${xy##* }"; if [ "$y" -lt 840 ] && [ "$y" -gt 60 ]; then printf '%s' "$xy"; return 0; fi; fi
    scroll down; sleep 0.6; done; find_el "$lbl"; }

# ── deterministic flow runner: a JSON list of steps ──────────────────────────
# step keys: launch|wait|screenshot|tap[x,y]|tapText|optionalTapText|tapId|type|
#            clearText[x,y]|scroll|scrollToText|dismiss|assertText|assertId
flow(){
  local f="${1:?usage: yukti flow <file.json>}"; [ -f "$f" ] || die "no flow file '$f'"; paths
  say "running flow: $f"
  # The step generator is fed on FD 3, NOT stdin: steps shell out to adb/idb,
  # and `adb shell` / subprocesses read stdin — if the loop read from the same
  # pipe they'd swallow the remaining steps, so only step 1 ran (and the flow
  # still reported PASS). Reading `<&3` from a process substitution also keeps
  # the loop in THIS shell (not a pipe subshell), so a step's `die` (exit 1)
  # aborts the whole flow with a non-zero status instead of being lost.
  while IFS=$'\x1f' read -r do_ val x y <&3; do
      set +e   # best-effort steps (dismiss/optionalTapText) return non-zero when
               # a label is absent; only an explicit `die` (assert fail / missing
               # required element) must stop the flow — not a benign miss.
      case "$do_" in
        wait)        wait_s "${val:-2}";;
        screenshot)  ok "shot → $(shot "$val")";;
        tap)         tap "$x" "$y";;
        tapText)     say "tap '$val'"; tap_text "$val";;
        optionalTapText) tap_text_optional "$val";;
        scroll)      scroll "${val:-down}";;
        scrollToText) scroll_to "$val" >/dev/null;;
        dismiss)     dismiss;;
        clearText)   clear_field "$x" "$y";;
        type)        say "type ${#val} chars"; type_str "$val";;
        assertText)  assert_text "$val";;
        tapId)       say "tap id '$val'"; tap_id "$val";;
        assertId)    assert_id "$val";;
        launch)      launch "$val";;
        *) warn "unknown step '$do_'";;
      esac
  done 3< <("$PY" -c 'import json,sys,os;[print("\x1f".join([s.get("do",""),os.path.expandvars(str(s.get("value",""))),str(s.get("x","")),str(s.get("y",""))])) for s in json.load(open(sys.argv[1]))["steps"]]' "$f")
  ok "flow complete: $f"
}

init(){ [ -f "$CONFIG" ] && die "$CONFIG exists"
  if [ "${1:-}" = android ] || [ "${YUKTI_PLATFORM:-}" = android ]; then cat > "$CONFIG" <<'JSON'
{
  "platform": "android",
  "projectRoot": ".",
  "android": { "avd": "Pixel_7_API_34" },
  "variants": {
    "qa":   { "platform": "android", "package": "com.you.app",     "gradleTask": "assembleDebug",   "envFile": ".env.qa" },
    "prod": { "platform": "android", "package": "com.you.app",     "gradleTask": "assembleRelease", "envFile": ".env.production" }
  }
}
JSON
  ok "wrote $CONFIG (android) — set your package, then 'yukti doctor' and 'yukti up qa'"; return; fi
  cat > "$CONFIG" <<'JSON'
{
  "platform": "ios",
  "projectRoot": ".",
  "workspace": "ios/YourApp.xcworkspace",
  "simulator": { "device": "iPhone 16 Pro" },
  "excludeIosAutolink": [],
  "easEnabled": false,
  "variants": {
    "qa":   { "platform": "ios", "scheme": "YourApp", "configuration": "Release", "bundleId": "com.you.app", "envFile": ".env.qa",         "appVariant": "development", "nodeEnv": "development", "easProfile": "simulator" },
    "prod": { "platform": "ios", "scheme": "YourApp", "configuration": "Release", "bundleId": "com.you.app", "envFile": ".env.production", "appVariant": "production",  "nodeEnv": "production",  "easProfile": "simulator" }
  }
}
JSON
  ok "wrote $CONFIG — edit it, then 'yukti doctor' and 'yukti up qa'"; }

usage(){ cat <<EOF
${B}yukti v$YUKTI_VERSION${R} — YUKTI — smart mobile-app QA automation for React Native / Expo

  yukti doctor              check/guide the toolchain (Xcode, node@22, cocoapods, idb)
  yukti init                write a starter yukti.config.json
  yukti scan                list device-only frameworks (no arm64-sim slice) to exclude
  yukti build <variant>     build a signed arm64 simulator .app (local)
  yukti pull  <variant>     pull an OFFICIAL simulator build from EAS (needs EXPO_TOKEN)
  yukti boot                create/boot the simulator
  yukti up    <variant>     build + boot + install + launch  (one shot)
  yukti flow  <file.json>   run a deterministic flow (Talos test-case engine — no AI, CI-ready)

  drive primitives (for flows or an AI agent — Claude Code / OpenAI):
  yukti shot [file]         screenshot the sim (an agent reads the PNG)
  yukti ui                  accessibility tree (JSON, coords in points)
  yukti find "<label>"      -> "x y" center of the first element matching label
  yukti tap <x> <y>         tap
  yukti type "<text>"       type (char-by-char = reliable; idb bulk-type drops chars)
  yukti clear <x> <y>       clear a text field
  yukti scroll <up|down>   scroll the screen · yukti scroll-to "<label>" scroll a label into view
  yukti dismiss             auto-dismiss common modals (Not Now / Skip / OK / Close…)
  yukti assert "<text>"     assert the text is on screen (perceivable text only, no scroll)
  yukti tap-id "<id>"       tap the element with this a11y id / resource-id segment
  yukti assert-id "<id>"    assert an element with this id is on screen

  flow steps: wait · screenshot · tap · tapText · optionalTapText · tapId · scroll · scrollToText · dismiss · type · clearText · assertText · assertId · launch
  config: \$YUKTI_CONFIG or ./yukti.config.json  ·  cross-platform: set variant "platform":"android"
EOF
}

# Resolve the target platform ONCE per invocation (env wins, else config), and
# export it so every primitive agrees. Previously each primitive defaulted to
# iOS (${YUKTI_PLATFORM:-ios}); a caller that hadn't exported it — the Studio
# server, or a bare `yukti flow` on an Android config — silently ran the iOS
# path (build/boot/find/tap/type). Config source of truth: top-level "platform",
# else the qa variant's platform, else ios.
if [ -z "${YUKTI_PLATFORM:-}" ] && [ -f "$CONFIG" ]; then
  YUKTI_PLATFORM="$(cfg platform "$(cfg variants.qa.platform ios)")"
fi
export YUKTI_PLATFORM="${YUKTI_PLATFORM:-ios}"

cmd="${1:-}"; shift || true
case "$cmd" in
  doctor) doctor;;
  init) init "$@";;
  scan) scan;;
  build) build "$@";;
  pull) pull_eas "$@";;
  boot) boot;;
  install) install "$@";;
  launch) launch "$@";;
  up) up "$@";;
  flow) flow "$@";;
  shot) shot "$@";;
  ui) ui;;
  find) find_el "$@";;
  tap) tap "$@";;
  "tap-text"|tapText) tap_text "$@";;
  scroll) scroll "$@";;
  "scroll-to"|scrollToText) scroll_to "$@";;
  dismiss) dismiss;;
  type) type_str "$@";;
  clear) clear_field "$@";;
  assert) assert_text "$@";;
  "tap-id"|tapId) tap_id "$@";;
  "assert-id"|assertId) assert_id "$@";;
  ""|-h|--help|help) usage;;
  *) die "unknown command '$cmd' — see 'yukti help'";;
esac
