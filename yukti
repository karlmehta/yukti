}

# One directory per run for anything measured from the device, made here and
# removed on the way out. Nested calls - the agent shelling out to `yukti tap`,
# Studio driving a flow - inherit it and share the measurement; only the shell
# that made it removes it, so a child cannot pull the floor out from under its
# parent. The alternative, naming the cache after the device, cannot tell two
# emulators apart: their serial is the port they took, not the AVD behind it.
if [ -z "${YUKTI_RUN_DIR:-}" ] || [ ! -d "${YUKTI_RUN_DIR:-}" ]; then
  YUKTI_RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/yukti-run.XXXXXX" 2>/dev/null || true)"
  export YUKTI_RUN_DIR
  [ -n "$YUKTI_RUN_DIR" ] && RUN_DIR_OWNED=1 || true
fi
# Not exported on purpose: a child PROCESS inherits the directory but never the
# right to delete it. A SUBSHELL is held off by something else - it does inherit
# this flag, and what saves it is that bash does not run an EXIT trap inside a
# subshell. Two different mechanisms: move this cleanup out of the trap into a
# plain call and the second one disappears without a sound.
run_dir_cleanup(){
  [ "${RUN_DIR_OWNED:-}" = 1 ] || return 0
  case "${YUKTI_RUN_DIR:-}" in */yukti-run.??????) rm -rf "$YUKTI_RUN_DIR";; esac
  return 0; }
trap run_dir_cleanup EXIT

cmd="${1:-}"; shift || true

# `install` is the one command that takes an option, and it may sit before the
# variant - `yukti install --apk build/app.apk android-qa`. Neither the option
# nor its value is a variant name, so the platform must not be resolved from
# one. Every other command still resolves from its first argument: a command
# that does not parse options must not be handed a variant it will never use,
# or `yukti up --apk x android-qa` would resolve a platform, build a variant
# called "--apk" with the default gradle task, boot a device, and only then
# stop. Refusing an unknown argument at the first step is the cheap failure.
install_variant(){ local a; while [ $# -gt 0 ]; do a="$1"; shift
    case "$a" in
      --apk) shift || true;;
      -*) ;;
      *) printf '%s' "$a"; return;;
    esac
  done; }

# Which platform this run drives is answered once, here, and only for the
# commands that drive something. init, doctor, scan and help touch no device,
# and `flow --check` reads a flow without performing any of it - all of them
# still run where there is no config at all, which is the case in CI.
case "$cmd" in
  flow) case " $* " in *" --check "*) ;; *) resolve_platform;; esac;;
  install) resolve_platform "$(install_variant "$@")";;
  build|pull|launch|up|"stop-app"|stopApp|"clear-state"|clearState) resolve_platform "${1:-}";;
  boot|shot|ui|find|tap|"tap-text"|tapText|scroll|"scroll-to"|scrollToText|dismiss|type|clear|assert|"open-url"|openUrl|\
  "tap-id"|tapId|"clear-id"|clearTextId|"assert-id"|assertId|"assert-box"|assertBox|"assert-not"|assertNotText|"assert-not-id"|assertNotId|"wait-for"|waitFor)
    resolve_platform;;
  # init, doctor, scan and help drive nothing, and a command this tool does not
  # know is answered by the dispatcher below - neither is a reason to ask which
  # platform a run is for.
  *) ;;
esac

case "$cmd" in
  doctor) doctor;;
  init) init "$@";;
  scan) scan;;
  build) build "$@";;
  pull) pull_eas "$@";;
  boot) boot;;
  install) install "$@";;
  launch) launch "$@";;
  "stop-app"|stopApp) stop_app "$@";;
  "clear-state"|clearState) clear_state "$@";;
  "open-url"|openUrl) open_url "$@";;
  up) up "$@";;
  flow) flow "$@";;
  shot) shot "$@";;
  ui) ui;;
  find) find_el "$@";;
  tap) tap "$@";;
  "tap-text"|tapText) tap_text "$@";;
  scroll) scroll_step "$@";;
  "scroll-to"|scrollToText) scroll_to_step "$@";;
  dismiss) dismiss;;
  type) type_str "$@";;
  clear) clear_field "$@";;
  assert) assert_text "$@";;
  "tap-id"|tapId) tap_id "$@";;
  "clear-id"|clearTextId) clear_id "$@";;
  "assert-id"|assertId) assert_id "$@";;
  "assert-box"|assertBox) assert_box_args "$@";;
  "assert-not"|assertNotText) assert_not_text "$@";;
  "assert-not-id"|assertNotId) assert_not_id "$@";;
  "wait-for"|waitFor) wait_for "$@";;
  ""|-h|--help|help) usage;;
  *) die "unknown command '$cmd' — see 'yukti help'";;
esac
