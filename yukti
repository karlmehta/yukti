# An assert must prove the element is ON SCREEN, not that the string appears
# somewhere in the dump. `ui | grep` matched invisible nodes, off-screen rows and
# attribute values, so an assertText passed on a screen that never opened. Reuse
# the same lookup taps use: relevance, ranking and real non-zero bounds.
# The match rule is part of the assertion, so the flow states it and the log
# repeats it: a green line that does not say how it matched cannot be read back.
assert_text(){ local q="${1:-}" m="${2:-exact}" xy st=0
  [ -n "$q" ] || die "assertText needs a non-empty value"
  case "$m" in exact|contains) ;; *) die "assertText: unknown match '$m' - use exact or contains";; esac
  xy="$(find_el "$q" assert "$m")" || st=$?
  [ "$st" -eq 0 ] || die "assert FAILED: $(lookup_err "$st")"
  [ -n "$xy" ] && ok "assert ($m): '$q' on screen at $xy" || die "assert FAILED ($m match): '$q' not on screen"; }
# Explicit-selector variants. tapText/assertText match on visible text and can
# land on a neighbouring caption; these two take an accessibility id / resource-id
# segment and match it exactly, or fail. An empty id is a failure, never a match:
# a flow step with a missing or misspelled `value` must stop the run, not tap a
# random point. Neither scrolls — use scrollToText first for a target below the fold.
tap_id(){ local q="${1:-}"; [ -n "$q" ] || die "tapId needs a non-empty id"; local xy st=0; xy="$(find_el "$q" id)" || st=$?; [ "$st" -eq 0 ] || die "$(lookup_err "$st")"; [ -n "$xy" ] || die "no element with id '$q'"; tap $xy; }
assert_id(){ local q="${1:-}"; [ -n "$q" ] || die "assertId needs a non-empty id"; local xy st=0; xy="$(find_el "$q" id)" || st=$?; [ "$st" -eq 0 ] || die "assert FAILED: $(lookup_err "$st")"; [ -n "$xy" ] && ok "assert id: '$q' on screen at $xy" || die "assert FAILED: no element with id '$q'"; }
# The density of the screen, for a constraint written in dp. Read once per run
# and kept: it cannot change under a run, and every box assertion would
# otherwise pay for another adb round trip. An override density wins when one is
# set - that is the density the app is actually laid out at.
ADPI=""
adpi(){
  [ -n "$ADPI" ] && { printf '%s' "$ADPI"; return 0; }
  # The lookup above ran in a command substitution, so the paths it set up died
  # with that subshell: without this, a machine whose adb is not on PATH answers
  # every dp constraint with "the device did not report its density" while every
  # other step works.
  apaths
  local out; out="$(adb shell wm density 2>/dev/null | tr -d '\r')"
  ADPI="$(printf '%s\n' "$out" | sed -n 's/^Override density: *\([0-9][0-9]*\).*/\1/p' | tail -1)"
  [ -n "$ADPI" ] || ADPI="$(printf '%s\n' "$out" | sed -n 's/^Physical density: *\([0-9][0-9]*\).*/\1/p' | tail -1)"
  [ -n "$ADPI" ] || return 1
  printf '%s' "$ADPI"; }
# ── assertBox: the geometry the lookup already read ──────────────────────────
# Every lookup reads the box of its candidates to decide whether they are on the
# screen at all, and then keeps the centre. What a layout check asks about lives
# in the numbers it drops: is this control still big enough to hit, is this
# header below the notch, did this banner go edge to edge. assertBox asks for the
# box instead and compares it with what the flow says.
#
# A constraint is written in pixels (48), in dp ("48dp") or as a share of the
# screen ("5%") - the share is of the width for the horizontal ones and of the
# height for the vertical ones, so the same flow file reads the same on a phone
# and on a tablet. dp is the unit the rules are written in: a touch target is 48
# of them on Android and 44 points on iOS, and on a 320 dpi screen 48 pixels is
# 24 dp - half the minimum, asserted as if it passed. The measured numbers go
# into the message whatever the unit: "48x50, expected height at least 96" is a
# bug report, "assert failed" is not.
#
# The spec arrives as one field of name/value pairs, packed with the two
# separators the conditions use - same reason: several of them belong to one step.
assert_box(){
  local q="${1:-}" kind="${2:-assert}" spec="${3:-}" what
  [ "$kind" = id ] && what="id" || what="text"
  [ -n "$q" ] || die "assertBox needs a non-empty $what"
  # A box assertion with no constraint passes on anything that is on the screen,
  # which is what assertText and assertId already say. The builder refuses it
  # before the run; this is the same door for the command line.
  [ -n "$spec" ] || die "assertBox needs at least one constraint - minWidth, minHeight, maxWidth, maxHeight, minX, minY, maxX, maxY"
  local dpi=""
  local out st=0
  out="$(find_el "$q" "$kind" exact box)" || st=$?
  [ "$st" -eq 0 ] || die "assert FAILED: $(lookup_err "$st")"
  [ -n "$out" ] || die "assert FAILED: no element with $what '$q'"
  local x1 y1 x2 y2 sx1 sy1 sx2 sy2
  read -r x1 y1 x2 y2 sx1 sy1 sx2 sy2 <<<"$out"
  local w=$((x2-x1)) h=$((y2-y1)) sw=$((sx2-sx1)) sh=$((sy2-sy1))
  local where="${w}x${h} at [$x1,$y1][$x2,$y2]" bad="" pair name val px n want
  while [ -n "$spec" ]; do
    case "$spec" in *"$COND_SEP"*) pair="${spec%%"$COND_SEP"*}"; spec="${spec#*"$COND_SEP"}";; *) pair="$spec"; spec="";; esac
    name="${pair%%"$COND_KV"*}"; val="${pair#*"$COND_KV"}"
    case "$val" in
      *%) n="${val%\%}"
          # A share of the screen needs a screen. A dump that does not report its
          # own rect cannot answer "5% of the height", and a question that cannot
          # be answered must not come back as a pass.
          case "$name" in
            minWidth|maxWidth)
              [ "$sw" -gt 0 ] || die "assert FAILED: '$name' is a share of the screen width, and this screen does not report its own rect"
              px=$(( sw * n / 100 ));;
            minHeight|maxHeight)
              [ "$sh" -gt 0 ] || die "assert FAILED: '$name' is a share of the screen height, and this screen does not report its own rect"
              px=$(( sh * n / 100 ));;
            # An edge is a place, not a length: "5% down the screen" is measured
            # from where the screen starts. On Android the root rect starts at
            # 0,0 and the two readings agree; an iOS window need not, and a
            # percentage counted from zero would then point outside it.
            minX|maxX)
              [ "$sw" -gt 0 ] || die "assert FAILED: '$name' is a share of the screen width, and this screen does not report its own rect"
              px=$(( sx1 + sw * n / 100 ));;
            *)
              [ "$sh" -gt 0 ] || die "assert FAILED: '$name' is a share of the screen height, and this screen does not report its own rect"
              px=$(( sy1 + sh * n / 100 ));;
          esac;;
      *dp) n="${val%dp}"
          if is_android; then
            # A dp that cannot be converted must not pass as a pixel: 48 unread
            # would compare against 48 pixels and call half a touch target fine.
            if [ -z "$dpi" ]; then
              # Called for the variable, not for what it prints: in a command
              # substitution the cache it fills would die with the subshell, and
              # every dp constraint would go back to the device for a number
              # that cannot change under a run.
              adpi >/dev/null || die "assert FAILED: '$name' is written in dp and the device did not report its density"
              dpi="$ADPI"
            fi
            px=$(( n * dpi / 160 ))
          else
            # An iOS frame is already in points, which is the density-independent
            # unit: 44pt is 44 here, and the conversion is the identity.
            px="$n"
          fi;;
      *) px="$val";;
    esac
    # Both numbers, because either alone hides half the answer: "at least 48dp"
    # does not say what that is on this screen, and "at least 96" does not say
    # which line of the flow file to change.
    if [ "$px" = "$val" ]; then want="$val"; else want="$val = $px px"; fi
    case "$name" in
      minWidth)  [ "$w"  -ge "$px" ] || bad="$bad, width at least $want (is $w)";;
      maxWidth)  [ "$w"  -le "$px" ] || bad="$bad, width at most $want (is $w)";;
      minHeight) [ "$h"  -ge "$px" ] || bad="$bad, height at least $want (is $h)";;
      maxHeight) [ "$h"  -le "$px" ] || bad="$bad, height at most $want (is $h)";;
      minX)      [ "$x1" -ge "$px" ] || bad="$bad, left edge at $want or more (is $x1)";;
      maxX)      [ "$x2" -le "$px" ] || bad="$bad, right edge at $want or less (is $x2)";;
      minY)      [ "$y1" -ge "$px" ] || bad="$bad, top edge at $want or more (is $y1)";;
      maxY)      [ "$y2" -le "$px" ] || bad="$bad, bottom edge at $want or less (is $y2)";;
      *) die "assertBox does not know the constraint '$name'";;
    esac
  done
  [ -z "$bad" ] || die "assert FAILED: $what '$q' is $where - expected ${bad#, }"
  ok "assert box: $what '$q' is $where"
}
# The same emptying, addressed by id. Coordinates were the only way to name the
# field, so a flow that addresses everything else by id had no way to clear one
# at all - and `type` appends: typed into a field that already holds text it
# makes a value neither the flow nor the app ever names, and the run fails on a
# later step, far from the line that caused it. The clearing itself, and every
# check around it, is the one `clearText` does.
clear_id(){ local q="${1:-}"; [ -n "$q" ] || die "clearTextId needs a non-empty id"; local xy st=0; xy="$(find_el "$q" id)" || st=$?; [ "$st" -eq 0 ] || die "$(lookup_err "$st")"; [ -n "$xy" ] || die "no element with id '$q'"; clear_field $xy "clearTextId '$q'"; }
# A lookup answers with coordinates, with "no such element", or with no answer at
# all - and "no answer" comes in two flavours the caller has to tell apart: the
# screen could not be read (status 1: the dump failed) and the screen was read but
# cannot be judged (status 3: it does not report its own bounds, so nothing on it
# can be called visible). Neither of them means the element is absent.
# Who says it, once. A lookup that could not read the screen at all has already
# printed the reason and recorded it for the step result - aui and ui end in
# `die`, and that `die` only kills the command substitution they run in. The
# caller adding "see the error above" printed that same line a second time, and
# on the quiet status 3 - a tree that arrived and cannot be judged, which nobody
# has spoken for - it pointed at an error that was never printed. So: stop the
# run without a word when the reason is already out, and supply the words when
# it is not.
# The caller's own words belong to status 3 alone: there the screen was read and
# the caller is the one who knows what it was looking for. Status 2 is a device
# that answered with something unreadable, which is no more the caller's fault
# than a failed dump - saying "no element at x,y" for it blames the point the
# step was aimed at.
lookup_die(){ local st="${1:-1}" msg="${2:-}"
  case "$st" in
    1) exit 1;;
    3) die "${msg:-$(lookup_err 3)}";;
    *) die "$(lookup_err "$st")";;
  esac; }
lookup_err(){ case "${1:-1}" in
    2) printf '%s' "the device answered, but not with a tree that can be read";;
    3) printf '%s' "the screen was read but does not report its own bounds, so nothing on it can be called visible";;
    *) printf '%s' "cannot read the screen - see the error above";; esac; }
# The negative assertions. Absence is the one verdict where an EMPTY answer is the
# pass, which makes it the one verdict that a missing answer passes by accident:
# an unreadable screen has no element on it either. Both statuses are checked
# before the verdict.
#
# Neither verb scrolls, by contract: a count of swipes cannot prove that something is
# absent, and they change the state the next step is about to check. What these
# two state is "not on the screen as it is now", and the guide says so in those
# words - a flow that means "not anywhere in this list" scrolls for itself.
# By hand the constraints are written name=value: the packed form the runner
# uses is two control characters, and nobody types those.
#   yukti assert-box tab-today id minWidth=48 minHeight=48
assert_box_args(){ local q="${1:-}" kind="${2:-}" spec="" pair
  # Without this, `assert-box email-input minWidth=48` reads the constraint as
  # the name of a lookup and then complains that no constraint was given.
  case "$kind" in
    assert|id) ;;
    *) die "usage: yukti assert-box \"<text or id>\" <assert|id> name=value [name=value ...]";;
  esac
  shift 2
  for pair in "$@"; do spec="${spec:+$spec$COND_SEP}${pair%%=*}$COND_KV${pair#*=}"; done
  assert_box "$q" "$kind" "$spec"; }
assert_not_text(){ local q="${1:-}" m="${2:-exact}" xy st=0
  [ -n "$q" ] || die "assertNotText needs a non-empty value"
  case "$m" in exact|contains) ;; *) die "assertNotText: unknown match '$m' - use exact or contains";; esac
  xy="$(find_el "$q" assert "$m")" || st=$?
  [ "$st" -eq 0 ] || die "assertNot FAILED: $(lookup_err "$st")"
  [ -z "$xy" ] || die "assertNot FAILED ($m match): '$q' IS on the screen, at $xy"
  ok "assertNot ($m): '$q' not on the current screen"; }
assert_not_id(){ local q="${1:-}" xy st=0
  [ -n "$q" ] || die "assertNotId needs a non-empty id"
  xy="$(find_el "$q" id)" || st=$?
  [ "$st" -eq 0 ] || die "assertNot FAILED: $(lookup_err "$st")"
  [ -z "$xy" ] || die "assertNot FAILED: an element with id '$q' IS on the screen, at $xy"
  ok "assertNot id: '$q' not on the current screen"; }
wait_s(){ sleep "${1:-2}"; }
# `wait` is a sleep, and a sleep is the wrong tool for a screen that loads its
# content: too short and the flow goes red at random, too long and every run
# pays for it, on every flow. scrollToText retries, but it SCROLLS between the
# tries - on a screen that is still loading it swipes the content away instead
# of waiting for it.
#
# waitFor polls the same lookup the taps and the oracle use, and it never
# scrolls. The timeout is the failure: a screen that never arrives is a red
# step, not a green one and not an eight-swipe detour.
#
# An unreadable screen is not "not there yet". The poll keeps going while the
# screen cannot be read, and the timeout then says which of the two happened -
# the distinction the lookup verbs already make.
wait_for(){ local q="${1:-}" t="${2:-10}" m="${3:-exact}" mode="${4:-assert}" xy readable=1 lst=1 t0 el label
  [ -n "$q" ] || die "waitFor needs a non-empty value"
  case "$t" in ''|*[!0-9]*|0) die "waitFor: timeout must be a whole number of seconds greater than zero, got '$t'";; esac
  case "$m" in exact|contains) ;; *) die "waitFor: unknown match '$m' - use exact or contains";; esac
  [ "$mode" = id ] && label="waitFor id" || label="waitFor ($m match)"
  say "$label: up to ${t}s for '$q'"
  t0=$SECONDS
  while :; do
    if xy="$(find_el "$q" "$mode" "$m")"; then readable=1
      [ -n "$xy" ] && { el=$((SECONDS - t0)); ok "$label: '$q' on screen at $xy after ${el}s"; return 0; }
    else lst=$?; readable=0; fi
    [ $((SECONDS - t0)) -lt "$t" ] || break
    sleep 0.5
  done
  [ "$readable" = 1 ] || die "$label FAILED after ${t}s waiting for '$q': $(lookup_err "$lst")"
  die "$label FAILED: '$q' not on screen after ${t}s"; }
# A direction reveals what lies that way: `down` shows what is further down the
# content, which means the finger travels up. Same for `left` and `right`.
#
# A name the tool does not know used to scroll DOWN - the `else` of a two-way
# test - so `{"do":"scroll","value":"sideways"}` swiped down and said nothing.
# The list is checked first now, and a typo stops the flow.
#
# On Android the vertical swipes used to be fixed device pixels, 700 to 300 at
# x=200. On a 1080x2400 screen that is a sixth of the height, all of it in the
# upper third, and eight of them - all scrollToText gives itself - covered about a
# screen and a third: an element further down the list failed as "not on screen
# after 8 swipes" while it was there. They are taken from the screen now, down
# the middle of its width from 70% of its height to 30% - the proportions that
# made those flows pass on a 1080x2400 emulator. Every vertical scroll goes
# further than it did; a flow that counted on a short swipe to stop near
# something wants scrollToText with "edges":"clear".
# The duration grows with the distance, 3 ms for every 4 px, which is the speed
# of the old swipe: 400 px in 300 ms. `input swipe` lets go at the speed it moved,
# so the same 300 ms over a longer distance would be a harder fling, and the list
# would keep moving after the finger is up - past rows that scrollToText reads
# only once the swipe is over. Only the distance changes, not the speed.
# When the screen size cannot be read, screen_wh answers with the recording basis
# and says so once, and the swipe is proportional to that: 349 px, a little
# shorter than the 400 it used to be.
# iOS follows the same rule in points, so a flow scrolls the same share of the
# screen on both platforms. The old iOS pair was 320 to 720 at x=200: 400 points,
# 46% of the 874-point basis. The new one is 349 points on that screen, 383 on a
# 956-point phone and 325 on an 812-point one: shorter than it was on every
# iPhone, and longer only on a screen taller than 1000 points, an iPad. This is
# the one place where the change goes against the title of #68. The duration is
# left to idb as it was.
# Written, not measured - no Mac.
# On Android the horizontal pair is computed from the screen as well: across the widest
# element that says it scrolls, from a fifth of its width to four fifths of it -
# or, when the screen has no such element, across the middle of the screen, with
# a line in the run to say that is what happened.
# The scroll STEP. `scroll` itself is also the blind swipe inside a search, which
# asks about the keyboard on its own, so the question lives here and not in it.
scroll_step(){
  case "${1:-down}" in up|down|left|right) ;; *) die "scroll: '${1:-down}' is not a direction - use up, down, left or right";; esac
  kb_before_swipe scroll || :
  scroll "${1:-down}"; }
scroll(){ local d="${1:-down}" w h
  case "$d" in up|down|left|right) ;; *) die "scroll: '$d' is not a direction - use up, down, left or right";; esac
  if is_android; then apaths
    case "$d" in
      up|down)
        local lo hi dur
        set -- $(screen_wh); w="${1:-$BASIS_W}"; h="${2:-$BASIS_H}"
        lo=$(( h * 30 / 100 )); hi=$(( h * 70 / 100 )); dur=$(( (hi - lo) * 3 / 4 ))
        if [ "$d" = down ]; then adb shell input swipe $(( w / 2 )) "$hi" $(( w / 2 )) "$lo" "$dur"
        else adb shell input swipe $(( w / 2 )) "$lo" $(( w / 2 )) "$hi" "$dur"; fi;;
      left|right)
        local cy x1 x2 span aim ast=0
        # A dump that failed is not the same answer as a screen with nothing to
        # aim at: it used to arrive as the second, so a broken dump printed the
        # warning and swiped blind. A bare `scroll` step has no lookup in front
        # of it to catch that later, so it dies here, like every other reader of
        # the screen.
        aim="$(ahscroller)" || ast=$?
        [ "$ast" -eq 0 ] || lookup_die "$ast"
        set -- $aim; cy="${1:-}"; x1="${2:-}"; x2="${3:-}"
        if [ -z "$cy" ]; then
          # Nothing on this screen says it scrolls sideways. The swipe still goes
          # out, because a dump does not always report what an app implements -
          # but it says so once per run, since this is the case where the gesture
          # is most likely to be taken for a press.
          # To stderr, like the other line that can be printed from inside a
          # command substitution: scroll_to runs in one, so a warning on stdout
          # would arrive inside the coordinates it returns.
          [ -n "${H_WARNED:-}" ] || warn "no horizontally scrollable element in the dump - swiping across the middle of the screen, which the app may read as a press on what is there" >&2
          H_WARNED=1
          set -- $(screen_wh); w="${1:-$BASIS_W}"; h="${2:-$BASIS_H}"
          cy=$(( h / 2 )); x1=0; x2="$w"
        fi
        span=$(( x2 - x1 ))
        if [ "$d" = left ]; then adb shell input swipe $(( x1 + span / 5 )) "$cy" $(( x2 - span / 5 )) "$cy" 300
        else adb shell input swipe $(( x2 - span / 5 )) "$cy" $(( x1 + span / 5 )) "$cy" 300; fi;;
    esac
    return
  fi
  paths
  case "$d" in
    up|down)
      local lo hi
      set -- $(screen_wh); w="${1:-$BASIS_W}"; h="${2:-$BASIS_H}"
      lo=$(( h * 30 / 100 )); hi=$(( h * 70 / 100 ))
      if [ "$d" = down ]; then idb ui swipe --udid "$(U)" $(( w / 2 )) "$hi" $(( w / 2 )) "$lo"
      else idb ui swipe --udid "$(U)" $(( w / 2 )) "$lo" $(( w / 2 )) "$hi"; fi;;
    left|right)
      set -- $(screen_wh); w="${1:-$BASIS_W}"; h="${2:-$BASIS_H}"
      if [ "$d" = left ]; then idb ui swipe --udid "$(U)" $(( w / 5 )) $(( h / 2 )) $(( w * 4 / 5 )) $(( h / 2 ))
      else idb ui swipe --udid "$(U)" $(( w * 4 / 5 )) $(( h / 2 )) $(( w / 5 )) $(( h / 2 )); fi;;
  esac; }
# a11y reports FULL-CONTENT coords; taps need ON-SCREEN coords. Scroll a label into the viewport.
# Stop on an unreadable screen instead of swiping eight times into the dark:
# a swipe changes state, and the state is what the next step is checking.
# The accepted band used to be written out as 60..840. Those are one device's
# numbers - an iPhone 16 Pro, 874 points tall - not a universal viewport. A dump
# reports coordinates in the screen's own space, so on a 720x1600 Android phone
# the bottom navigation sits at y=1497 and every tab read as off-screen: each tap
# on one paid the full eight swipes before it acted, and those swipes unload the
# rows the NEXT step asserts on, which then reads as a defect in the app.
# Keep the proportions and scale them to the screen the run is actually on. On
# the original 874-point basis the bounds come out as 60 and 840, unchanged.
# The basis those numbers were written against: the screen Studio records on, an
# iPhone 16 Pro at 402x874 points. Same env names Studio already uses for it
# (studio/server.py DEVICE_PT_W/H), so one override covers both halves.
BASIS_W="${YUKTI_DEVICE_PT_W:-402}"; BASIS_H="${YUKTI_DEVICE_PT_H:-874}"; BAND_TOP=60; BAND_BOTTOM=840
# Where a per-run cache lives. Set once per invocation just before the command
# runs (see the bottom of this file) and inherited by everything the run shells
# out to. Empty when there is no such directory, and then nothing is cached at
# all: the device is asked every time and the answer is still correct, only
# slower. A placeholder path would be worse than nothing - a flow is free to
# name any directory in a screenshot step and would create it, and a cache
# under a fixed name outlives the run, which is the bug this replaced.
run_dir(){ printf '%s' "${YUKTI_RUN_DIR:-}"; }
# Screen size in the same space the dump reports. Cached in a file, not in a
# variable: every caller reads this through $( ), and an export from a command
# substitution never reaches the caller, so a variable would re-ask the device on
# every step. Asking must never be fatal and must never silently change geometry:
# on any failure the answer is the basis, which is exactly the old behaviour of
# the band. The vertical swipe reads it too, and on the basis it is 349 px, a
# little shorter than the 400 it used to be - the warning below says so.
#
# The cache belongs to the RUN, not to the device: RUN_DIR is made once per
# invocation and removed when it ends. A device-named key cannot do this job -
# an emulator's serial is its port, not its AVD, so two AVDs started one after
# the other are both emulator-5554 and the second would read the first one's
# geometry with nothing in the log to say so; a resize on a live device does not
# change the serial at all. Scoped to the run, a stale answer cannot exist:
# the run that measured it is the only run that can read it.
screen_wh(){ local d f m out w h
  d="$(run_dir)"; f=''; m=''
  # No run directory, no cache: both halves stay empty and every lookup asks.
  [ -n "$d" ] && { f="$d/screen-$YUKTI_PLATFORM"; m="$f.fallback"; }
  [ -n "$f" ] && [ -s "$f" ] && { cat "$f"; return 0; }
  out=''
  if is_android; then
