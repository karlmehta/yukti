# The words for a miss that never saw the element, for the two verbs that search.
scroll_miss(){ case "$1" in
    6) printf "reached the end of the list going %s, '%s' is not in it" "$3" "$2";;
    7) printf "still moving after %s swipes %s, '%s' not found" "$SCROLL_TRIES" "$3" "$2";;
    8) printf "no scrollable list on screen - searched %s swipes %s, '%s' not found" "$SCROLL_TRIES_BLIND" "$3" "$2";;
