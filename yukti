#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# yukti — a portable local iOS-Simulator QA rig for React Native / Expo apps.
#
#   build → sign → boot → install → launch → drive.  No cloud device farm.
#
# Two ways to run tests, and AI is OPTIONAL:
#   • Deterministic flows   →  `yukti flow flows/login.json`   (zero AI, CI-ready)
#   • AI-driven exploration →  any agent (Claude Code / OpenAI computer-use)
#                              drives the primitives below (shot/ui/find/tap/type)
#
# The whole rig is Apple tools + idb. Expo/EAS is an optional adapter, not a dep.
#
# MIT licensed. https://github.com/<you>/yukti
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

YUKTI_VERSION="0.1.0"
CONFIG="${YUKTI_CONFIG:-yukti.config.json}"
PY="/usr/bin/python3"                       # system python: reliable expat + json
NODE22="/opt/homebrew/opt/node@22/bin"      # RN/Metro pins node 22; sys node may be broken
IDB_BIN="$HOME/Library/Python/3.9/bin"      # fb-idb CLI install location

# ── pretty ───────────────────────────────────────────────────────────────────
c(){ printf '\033[%sm' "$1"; }; R=$(c 0); B=$(c '1;36'); G=$(c '1;32'); Y=$(c '1;33'); E=$(c '1;31')
say(){ printf '%s▸%s %s\n' "$B" "$R" "$*"; }
ok(){  printf '%s✓%s %s\n' "$G" "$R" "$*"; }
warn(){ printf '%s!%s %s\n' "$Y" "$R" "$*"; }
# A step a condition switched off. Not a warning (nothing went wrong) and not a
# pass (nothing was done), so it gets its own mark in the run.
skipped(){ printf '%s~%s %s\n' "$Y" "$R" "$*"; }
# The last words of a failing step are also the message its result entry needs,
# so keep a copy when a flow is running. The console output is unchanged.
#
# Where the step was written is part of those words. The verbs that fail most -
# tapText, waitFor, assertText, assertId, tapId, screenshot - die on their own
# and never come back with a status, so a suffix added where the status is read
# would be missing from exactly the steps a shared block is made of: the report
# would say `03 tapText Sign In` for forty-five flows and never name the one
# file to fix. The flow loop sets YUKTI_STEP_SRC for the step it is running -
# and this process owns that variable, whatever it inherited: a value left in
# the environment by a caller used to be printed after a message that belongs to
# no step at all, `no flow file 'x.json' (stale from parent)`.
YUKTI_STEP_SRC=""
die(){ local m="$*"; if [ -n "${YUKTI_STEP_SRC:-}" ]; then m="$m ($YUKTI_STEP_SRC)"; fi
  printf '%s✗%s %s\n' "$E" "$R" "$m" >&2; [ -n "${YUKTI_STEP_ERR:-}" ] && printf '%s' "$m" > "$YUKTI_STEP_ERR"; exit 1; }

need_config(){ [ -f "$CONFIG" ] || die "no config at '$CONFIG' — run 'yukti init' or set YUKTI_CONFIG"; }

# ── config reader (dotted path; prints scalars raw, lists/objects as JSON) ─────
cfg(){ need_config; "$PY" - "$CONFIG" "$1" "${2:-}" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); default=sys.argv[3] if len(sys.argv)>3 else ""
cur=d
try:
    for k in sys.argv[2].split('.'):
        cur=cur[k]
except (KeyError,TypeError):
    print(default); sys.exit(0)
print(cur if not isinstance(cur,(list,dict)) else json.dumps(cur))
PY
}

app_dir(){ ROOT="$(cfg projectRoot .)"; cd "$ROOT" 2>/dev/null || die "projectRoot '$ROOT' not found"; }
paths(){ export PATH="$NODE22:$IDB_BIN:/opt/homebrew/bin:$PATH"; }
udid_file(){ echo "${TMPDIR:-/tmp}/yukti-udid"; }
booted(){ xcrun simctl list devices 2>/dev/null | grep -m1 Booted | grep -oE '[0-9A-F-]{36}' || true; }
# The platform of this run, resolved once before the command runs (bottom of the
# file). Every primitive asks this and nothing else, so one run drives one
# platform: `yukti up android-qa` and `yukti flow` on the same config could
# disagree, because the first read the variant and the second a global that
# defaulted to iOS.
is_android(){ [ "${YUKTI_PLATFORM:?the platform of this run was never resolved}" = android ]; }

# Sources, in order: the environment, the platform of the variant this
# invocation is about, the top-level "platform". The variant is the one named on
# the command line, else $YUKTI_VARIANT, which is what Studio sets when a variant
# is picked in the panel. Nothing left to ask is not an iOS run - it is a run
# that cannot know what it is driving, so it says so and stops. The answer names
# its source: which platform, and which of the three said so.
resolve_platform(){
  local v="${1:-}" p='' src='' vp='' why=''
  [ -n "$v" ] || v="${YUKTI_VARIANT:-}"
  [ -n "$v" ] && [ -f "$CONFIG" ] && vp="$(cfg "variants.$v.platform")"
  if [ -n "${YUKTI_PLATFORM:-}" ]; then
    p="$YUKTI_PLATFORM"; src='$YUKTI_PLATFORM'
    # A variant that names its own platform states a fact about that variant,
    # not a preference. When the environment pins a different one, one of the
    # two is wrong, and picking either is the silent answer this whole change
    # exists to end.
    [ -z "$vp" ] || [ "$vp" = "$p" ] || die "\$YUKTI_PLATFORM says $p and variant '$v' says $vp - they cannot both be the platform of this run"
  elif [ -f "$CONFIG" ]; then
    if [ -n "$vp" ]; then p="$vp"; src="variant '$v'"
    else p="$(cfg platform)"; [ -n "$p" ] && src="\"platform\" in $CONFIG"; fi
  fi
  if [ -z "$p" ]; then
    # Say which of the three was asked and what it answered. Assembled here and
    # not inside the message: a ${v:-...} there reads as the variant's own name.
    if [ ! -f "$CONFIG" ]; then
      why="and there is no config at '$CONFIG' - run 'yukti init' or set YUKTI_CONFIG"
    else
      if [ -z "$v" ]; then why="no variant was named (either a command that takes one, or \$YUKTI_VARIANT)"
      elif [ -z "$(cfg "variants.$v")" ]; then why="there is no variant '$v' in $CONFIG, and it"
      else why="variant '$v' does not name a platform, and $CONFIG"; fi
      [ -n "$v" ] || why="$why, and $CONFIG"
      why="$why has no top-level \"platform\""
    fi
    die "cannot tell which platform this run is for: \$YUKTI_PLATFORM is not set, $why"
  fi
  case "$p" in ios|android) ;; *) die "'$p' is not a platform - the only ones are ios and android (from $src)";; esac
  export YUKTI_PLATFORM="$p"
  # To stderr: `yukti find`, `yukti shot` and `yukti ui` put an answer on stdout
  # that a caller reads.
  say "platform: $p (from $src)" >&2; }

# ── Android backend (adb + uiautomator + gradle) ─────────────────────────────
# 1:1 mirror of the iOS path. Implemented; validate on a Mac with the Android SDK.
# Android debug APKs are auto-signed with the debug key — none of the iOS signing/
# keychain/arch pain applies. Config per variant: platform:"android", package,
# gradleTask (default assembleDebug); global android.avd for the emulator.
ANDROID_SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
apaths(){ export PATH="$NODE22:$ANDROID_SDK/platform-tools:$ANDROID_SDK/emulator:$ANDROID_SDK/cmdline-tools/latest/bin:/opt/homebrew/bin:$PATH"; }

build_android(){ local V="$1"; app_dir; apaths
  local task apk env; task="$(cfg variants.$V.gradleTask assembleDebug)"; env="$(cfg variants.$V.envFile)"
  [ -n "$env" ] && [ -f "$env" ] && cp "$env" .env.local && ok "env: $env → .env.local"
  say "gradle $task"; ( cd android && ./gradlew "$task" ) || die "gradle build failed"
  apk="$(find android/app/build/outputs/apk -name '*.apk' 2>/dev/null | head -1)"
  [ -n "$apk" ] || die "no APK produced"; echo "$apk" > "${TMPDIR:-/tmp}/yukti-apk-$V"; ok "built: $apk"; }
boot_android(){ apaths; local avd; avd="$(cfg android.avd Pixel_7_API_34)"
  if ! adb devices 2>/dev/null | grep -q emulator; then say "starting emulator $avd"; ( "$ANDROID_SDK/emulator/emulator" -avd "$avd" -no-boot-anim >/dev/null 2>&1 & ); fi
  adb wait-for-device; until [ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; do sleep 2; done; ok "emulator booted"; }
# Where the APK comes from, in order: the path named on the command line, the
# variant's "apkPath", and last the file the build step wrote. An artifact an
# earlier CI job built never had a build step here to write that file, and there
# was no other way in - the path had to be forged into a temporary file named by
# an internal convention, so installing fell out of the runner and the job ran
# `adb install` itself.
apk_of(){ local V="$1" want="${2:-}" p='' src
  if [ -n "$want" ]; then p="$want"; src="--apk"
  else
    if [ -f "$CONFIG" ]; then p="$(cfg "variants.$V.apkPath")"; fi; src="\"apkPath\" of variant '$V'"
    # A relative path there is relative to the config that names it. Taken from
    # the current directory instead, the same config would install a different
    # file depending on where the command was typed - and CI types it from
    # somewhere else than a laptop does.
    case "$p" in ''|/*) ;; *) p="$(cd "$(dirname "$CONFIG")" && pwd)/$p";; esac
    if [ -z "$p" ]; then
      p="$(cat "${TMPDIR:-/tmp}/yukti-apk-$V" 2>/dev/null || true)"; src="the build step"
      [ -n "$p" ] || die "no APK to install for '$V': pass --apk <path>, set variants.$V.apkPath, or run 'yukti build $V' first"
    fi
  fi
  [ -f "$p" ] || die "the APK named by $src is not a file: '$p'"
  printf '%s' "$p"; }

install_android(){ apaths; local V="$1" apk; apk="$(apk_of "$V" "${2:-}")"
  adb install -r "$apk" && ok "installed $(basename "$apk")"; }
launch_android(){ apaths; local pkg; pkg="$(cfg variants.$1.package)"; adb shell monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 && ok "launched $pkg"; }
# A screenshot value is a NAME, not a path. RUNBOOK says the files land in
# $TMPDIR and that the flows only name them; they landed in whatever directory
# the run was started from, so a suite scattered pngs across the caller's tree
# while $TMPDIR stayed empty. Join a relative name to $TMPDIR. An absolute path
# is still taken as given, and a name with a directory in it gets that directory
# created rather than failing the step.
shot_path(){ local n="${1:-yukti-shot.png}"
  # A name is a name. ".." in it would write outside $TMPDIR while reading like
  # a file inside it, so refuse rather than guess what was meant.
  case "$n" in *..*) die "screenshot name must not contain '..': '$n'";; esac
  case "$n" in /*) printf '%s' "$n";; *) printf '%s/%s' "${TMPDIR:-/tmp}" "$n";; esac; }
ashot(){ apaths; local o; o="$(shot_path "${1:-}")"; mkdir -p "$(dirname "$o")"; adb exec-out screencap -p > "$o" && echo "$o"; }
# Delete the dump before writing a new one. uiautomator refuses to dump while the
# screen is animating ("could not get idle state!"), the error was swallowed, and
# `cat` then served the tree of the PREVIOUS call: the next assert checked the
# previous screen and passed. A refusal is a normal state right after a tap, so
# retry a few times the way the iOS ui() already does, and only then give up.
# Remove, dump and read run in ONE adb round trip: a lookup used to cost two, a
# scroll_to up to eighteen.
#
# What counts as an answer is the WHOLE tree, not "some bytes". Non-empty is not
# enough:
# `cat` on a file uiautomator never wrote answers "No such file or directory" ON
# STDOUT through some adb shell protocol versions, and the daemon prints "* daemon
# started successfully *" on stdout too. Either one used to pass the emptiness
# check and reach the parser, which found no nodes and reported an absent element -
# the very confusion this retry exists to prevent. A dump cut off mid-tree does
# the same thing while looking even more like a tree, so the closing tag has to
# be there too: uiautomator writes the document in one go, and the end of it is
# the only evidence that nothing was lost on the way out.
#
# The file name carries the pid, so a dump that did not happen cannot be answered
# with the file some earlier run left on the device: `rm -f` failing silently was
# the one path back to serving a stale tree, and a per-run name closes it. The
# file is removed again after reading, in the same round trip.
# A tree held for the length of one step. A step that looks for several things
# on the SAME screen - dismiss looks for nine labels - used to read the screen
# once per thing, and every read after the first was of a screen that nothing
# had touched. A step fills this, reads as often as it likes, and empties it
# before anything taps: a held tree outliving a tap would be a step deciding
# against a screen that is no longer there.
HELD_TREE=""
aui(){ [ -n "$HELD_TREE" ] && { printf '%s' "$HELD_TREE"; return 0; }
  apaths; local xml i f="/sdcard/yukti-dump-$$.xml"
  for i in 1 2 3; do
    xml="$(adb shell "rm -f $f; uiautomator dump $f >/dev/null 2>&1; cat $f 2>/dev/null; rm -f $f" 2>/dev/null)"
    case "$xml" in *"<hierarchy"*"</hierarchy>"*) printf '%s' "$xml"; return 0;; esac
    [ "$i" = 3 ] || sleep 0.6
  done
  die "uiautomator produced no usable dump after 3 tries - the screen may still be animating"; }
afind(){ apaths; aui | "$PY" -c '
import sys,re,html
# Rank candidates instead of taking the first substring hit. Honors resource-id
# and prefers the interactive field over a nearby static caption — "Email" used
# to hit the "or use email" caption ~100px above the input, and "Password" hit
# the "Forgot Password?" link. A node now must be relevant (query appears in its
# text / content-desc / resource-id) AND scores highest to win; an editable /
# clickable / focusable node outranks a plain caption.
# mode="id": explicit selector. The resource-id segment must match EXACTLY and
# nothing else is considered — a flow that asks for an id gets that element or fails.
# Whitespace is normalised on both sides. unescape turns &#10; into a real line
# break, and a two-line caption would otherwise be assertable only by writing the
# line break into the flow file.
norm=lambda s: " ".join(s.split())
# The oracle compares the query as written; the locator modes keep folding case,
# because a flow author naming a button does not mean its capitalisation.
q_raw=norm(sys.argv[1]); q=q_raw.lower()
mode=(sys.argv[2] if len(sys.argv)>2 else "text")
match=(sys.argv[3] if len(sys.argv)>3 else "exact")
xml=sys.stdin.read()
# Nothing arrived: the dump failed and said so on its own line. Status 1 is "the
# screen could not be read"; status 3 below is the different, quieter case where
# a tree did arrive and cannot be judged.
if not xml.strip(): sys.exit(1)
# Screen rect = the bounds of the ROOT node, i.e. the first bounds= in the dump.
# Anything whose centre falls outside it is scrolled away or parked off-screen:
# present in the tree, invisible to the user. Taking the maximum over every node
# instead would let a node larger than the viewport widen the rect - and the rows
# scrolled out of a list are exactly the ones that report such bounds, so the
# filter would loosen on the screens it was written for.
SX1=SY1=SX2=SY2=0
_m=re.search(r"bounds=\"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]\"", xml)
if _m: SX1,SY1,SX2,SY2=map(int,_m.groups())
# No usable screen rect means the off-screen filter cannot run. A tap may still be
# worth attempting, but a check that cannot check must not report success - and
# assertId is as much an oracle as assertText. tapId loses nothing by it: it does
# not scroll, and a tap outside the window is useless anyway.
#
# Status 3, not silence: an empty answer means "the element is not there", and a
# negative assertion or a `when` condition PASSES on that answer. The screen that
# cannot be judged has to say so in a way the caller can read.
if mode in ("assert","id") and not (SX2>SX1 and SY2>SY1): sys.exit(3)
best=None; best_score=0
for m in re.finditer(r"<node\b[^>]*>", xml):
    tag=m.group(0)
    def a(n):
        # uiautomator escapes &, <, > and the quote characters. Unescaped,
        # assertText "Terms & Conditions" fails on the very screen that shows it,
        # and assertText "amp" passes on any screen with an ampersand - markup
        # matching through the back door.
        mm=re.search(n+r"=\"([^\"]*)\"",tag); return norm(html.unescape(mm.group(1))) if mm else ""
    text_raw=a("text"); desc_raw=a("content-desc")
    text=text_raw.lower(); desc=desc_raw.lower()
    rid=a("resource-id"); rid_seg=rid.split("/")[-1].lower()  # com.app:id/email -> email
    cls=a("class"); editable=cls.endswith("EditText")
    clickable=a("clickable")=="true"; focusable=a("focusable")=="true"
    if mode=="id":
        # An empty query must match nothing. The flow runner passes value="" for a
        # missing or misspelled key, and "" is the resource-id of most nodes: the
        # step would then report success and tapId would tap an arbitrary point.
        if not q or q!=rid_seg: continue
        score=10
    elif mode=="assert":
        # An assertion is the test oracle: it may only match what a person can
        # perceive - visible text or the accessibility label. Matching a
        # resource-id, a class name or an attribute lets a step pass on markup.
        #
        # The whole label, and the case as written. A substring match made a
        # false green cheap: assertText "net" passed on a screen whose only
        # relevant row said "Network & internet", and a check that passes on
        # three letters of another sentence has not checked anything. A flow
        # that does want the old rule says so: {"match":"contains"}.
        if match=="contains":
            if not (q and (q in text or q in desc)): continue
        else:
            if not (q_raw and q_raw in (text_raw, desc_raw)): continue
        score=10
    else:
        if not (q and (q in rid_seg or q in text or q in desc)): continue
        score=0
        if q==rid_seg: score+=6
        elif q in rid_seg: score+=5
        if q==text or q==desc: score+=4
        elif q in text or q in desc: score+=2
        if editable: score+=3
        if clickable: score+=1
        if focusable: score+=1
    if score<=best_score: continue
    b=re.search(r"bounds=\"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]\"",tag)
    if not b: continue
    x1,y1,x2,y2=map(int,b.groups())
    if not (x2>x1 and y2>y1): continue   # zero-area node: in the tree, not on the screen
    cx,cy=(x1+x2)//2,(y1+y2)//2
    if SX2>SX1 and SY2>SY1 and not (SX1<=cx<SX2 and SY1<=cy<SY2): continue  # off-screen
    best=(cx,cy); best_score=score
if best: print(best[0],best[1])
' "$1" "${2:-text}" "${3:-exact}"; }
# Where a horizontal swipe should land, from the dump. A swipe across the middle
# of the screen lands on whatever is there, and an element that does not claim
# the gesture may be pressed instead of scrolled: measured on the app under test,
# a horizontal swipe across a clickable row opened that row's share sheet, and a
# search of eight swipes did it eight times. The dump says which nodes scroll, and
# one that scrolls and is wider than it is tall is what a horizontal swipe is for.
# Prints "cy x1 x2" of the widest such node, or nothing when the screen has none.
ahscroller(){ aui | "$PY" -c '
import re,sys
xml=sys.stdin.read()
best=None
for m in re.finditer(r"<node\b[^>]*>", xml):
    t=m.group(0)
    # No single quote anywhere in this snippet: it lives inside a single-quoted
    # shell string. With one, the string ended here, the rest of the code became
    # shell words, and the lookup answered nothing at all - silently, because a
    # screen with no sideways scroller is a legitimate answer.
    if re.search(r"scrollable=\"true\"", t) is None: continue
    b=re.search(r"bounds=\"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]\"", t)
    if not b: continue
    x1,y1,x2,y2=map(int,b.groups())
    w,h=x2-x1,y2-y1
    # Taller than wide is a vertical list, whatever else it is.
    if w<=h or w<80 or h<20: continue
    # The WIDEST, which is what the guide and the runbook promise. By area a
    # 900x400 carousel would win over a 1080x100 tab strip, and then the code and
    # the text would mean different things - the area is only the tie-break.
    if best is None or (w,w*h)>(best[0],best[1]): best=(w,w*h,(y1+y2)//2,x1,x2)
if best: print(best[2],best[3],best[4])
'; }
atap(){ apaths; adb shell input tap "$1" "$2"; }
atype(){ apaths; local s="$1" q
  # Quote for the ON-DEVICE shell so metacharacters can't expand. Unquoted, a *
  # in a password was glob-expanded by /system/bin/sh (an 8-char password
  # arrived as 11 chars). Single-quote the arg (escaping embedded ' as '\''),
  # then map spaces to %s which `input text` turns back into spaces.
  q=$(printf '%s' "$s" | sed "s/'/'\\\\''/g")
  q=${q// /%s}
  adb shell "input text '$q'"; }
# Keys are named in the flow file, never numbered: a step that says `66` reads as
# noise and stops being true the moment the platform changes. These six names are
# the whole vocabulary - anything else stops the run instead of pressing nothing.
KEY_NAMES="back enter home delete tab escape"
akey(){ apaths; local c
  case "$1" in back) c=4;; enter) c=66;; home) c=3;; delete) c=67;; tab) c=61;; escape) c=111;;
    *) die "pressKey: no Android key code for '$1'";; esac
  adb shell input keyevent "$c"; }
# The IME's own answer about itself. A soft keyboard draws in its own window and
# never appears in the view dump the flows read, so "is it up" cannot be asked of
# the screen. Three outcomes, not two: up (0), down (1), and the device did not
# answer (2) - answering "down" to the third would let a step report success on a
# device that said nothing.
akb_shown(){ apaths; local s
  s="$(adb shell dumpsys input_method 2>/dev/null | grep -o "mInputShown=[a-z]*" | head -1 | cut -d= -f2 | tr -d "\r")"
  [ -n "$s" ] || return 2
  [ "$s" = true ]; }
# What sits under a point: its class, then its text. The rig has to be able to
# say what a field holds AFTER acting on it - a clear that is not checked is the
# same silent success this tool keeps finding elsewhere - and the class comes
# with it because "the text did not change" proves an empty field only when the
# thing under the point is a field. Aimed at a caption, it proves nothing at all.
# Two questions, one dump. "at" answers what sits under a point - the flow's own
# coordinates, before anything is touched. "focused" answers which text field
# holds focus now, and that is the field the keys will reach: after the keyboard
# opens the layout can move the field out from under the coordinates that opened
# it, and a check that kept hit-testing the old point would be reading a
# different node than the one being cleared.
afield(){ apaths; aui | "$PY" -c '
import re,sys
mode=sys.argv[1]
x0,y0=(int(sys.argv[2]),int(sys.argv[3])) if mode=="at" else (0,0)
best=None; best_area=0; best_edit=False
xml=sys.stdin.read()
# Nothing arrived: the dump failed and aui has already said so. Status 1 is "the
# screen could not be read", and it has to leave here as 1 - status 3 below is
# "the screen was read and there is no such field", which the caller reports in
# its own words. Without this line an unreadable screen left as 3 and clearText
# blamed the point it was aimed at.
if not xml.strip(): sys.exit(1)
for m in re.finditer(r"<node[^>]*?>", xml):
    tag=m.group(0)
    b=re.search(r"bounds=\"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]\"", tag)
    if not b: continue
    x1,y1,x2,y2=map(int,b.groups())
    if not (x2>x1 and y2>y1): continue
    cls=re.search(r"class=\"([^\"]*)\"", tag)
    txt=re.search(r"text=\"([^\"]*)\"", tag)
    enb=re.search(r"enabled=\"([^\"]*)\"", tag)
    fcb=re.search(r"focusable=\"([^\"]*)\"", tag)
    res=re.search(r"resource-id=\"([^\"]*)\"", tag)
    foc=re.search(r"focused=\"([^\"]*)\"", tag)
    cls=cls.group(1) if cls else ""; edit="EditText" in cls
    if mode=="focused":
        if not (edit and foc and foc.group(1)=="true"): continue
    else:
        if not (x1<=x0<x2 and y1<=y0<y2): continue
    area=(x2-x1)*(y2-y1)
    # The field wins over the row that contains it; among equals, the smaller.
    if best is None or (edit and not best_edit) or (edit==best_edit and area<best_area):
        best=(cls, (enb.group(1) if enb else ""), (fcb.group(1) if fcb else ""),
              (res.group(1) if res else ""), "%d %d %d %d"%(x1,y1,x2,y2),
              txt.group(1) if txt else "")
        best_area=area; best_edit=edit
if best is None: sys.exit(3)
sys.stdout.write("%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s" % best)
' "$@"; }
# Select all, then one delete. Forty blind deletes were a guess about how much
# was in the field and about where the caret sat; two calls are neither. The
# result is then read back, because the only fact that matters here is the state
# of the field, not that the keys were accepted.
aclear(){ apaths; local x="$1" y="$2" vb="${3:-clearText}" sdk before after probe
  sdk="$(adb shell getprop ro.build.version.sdk 2>/dev/null | tr -d "\r")"
  case "$sdk" in ""|*[!0-9]*) die "$vb: the device did not report its Android version";; esac
  # The version is the first line and it does stop the run here. What it cannot
  # cover is the line below it: on API 30 the shell answers an unknown command
  # with its usage text and exit code 0, so `|| die` after the key combination
  # is blind there. The read-back at the end is what holds if this threshold
  # ever turns out to be wrong again. No quiet fallback to deleting character by
  # character: a clear that only looks like one is what this verb exists to end.
  [ "$sdk" -ge 31 ] || die "$vb needs Android 12 (API 31) or newer - 'input keycombination' does not exist on API $sdk"
  local cls enb fcb res box out res2 box2 txt2
  # What the flow aimed at, read BEFORE the tap: a disabled or read-only field
  # takes no focus and no keys, and its text would sit there unchanged through
  # select-all, delete and the probe below - three readings agreeing on a lie.
  out="$(afield at "$x" "$y")" || lookup_die $? "$vb: no element at $x,$y"
  IFS=$'\x1f' read -r cls enb fcb res box before <<<"$out"
  case "$cls" in *EditText*) ;; *) die "$vb: the element at $x,$y is a ${cls:-node with no class}, not a text field";; esac
  [ "$enb" = true ] || die "$vb: the field at $x,$y is disabled - it takes no keys"
  [ "$fcb" = true ] || die "$vb: the field at $x,$y cannot take focus - the keys would go elsewhere"
  adb shell input tap "$x" "$y" || die "$vb: the device refused the tap on the field"
  # From here on the focused field is the subject: it is the one the keys reach.
  # Which is only safe once it is the SAME field - a tap that opened a picker,
  # or landed on a keyboard the dump does not show, leaves focus where it was,
  # and clearing that field would be reported as clearing this one.
  out="$(afield focused)" || die "$vb: the tap at $x,$y did not put focus in a text field"
  IFS=$'\x1f' read -r cls enb fcb res2 box2 txt2 <<<"$out"
  # Two ids that differ settle it. Two that MATCH settle nothing: a resource id
  # is not unique - the rows of a list and the repeated rows of a form share
  # one. So the second question is asked every time: the same rectangle, or the
  # same text it had before the tap. A field that is neither is another field.
  if [ -n "$res" ] && [ -n "$res2" ] && [ "$res" != "$res2" ]; then
    die "$vb: focus is in a different field ($res2), not the one at $x,$y ($res)"
  fi
  if [ "$box" != "$box2" ] && [ "$before" != "$txt2" ]; then
    die "$vb: focus is in a different field than the one at $x,$y"
  fi
  if [ "$box" != "$box2" ]; then
    warn "$vb: the field moved to $box2 when the keyboard opened"
  fi
  adb shell input keycombination 113 29 || die "$vb: the device refused select-all (Ctrl+A)"
  adb shell input keyevent 67 || die "$vb: the device refused the delete key"
  out="$(afield focused)" || lookup_die $? "$vb: nothing on the screen has focus"
  IFS=$'\x1f' read -r cls enb fcb res box after <<<"$out"
  [ -n "$after" ] || { ok "$vb: field empty at $x,$y"; return 0; }
  # Any text left is unresolved, whatever it is and whether or not it changed:
  # an EditText with nothing in it reports its HINT in the same attribute that
  # carries its text, and a select-all that did not take leaves the delete to
  # remove ONE character - which also changes the text and would read as
  # success. One more delete separates the two: on an empty field it changes
  # nothing, on a field still holding text it takes another character.
  adb shell input keyevent 67 || die "$vb: the device refused the delete key"
  out="$(afield focused)" || lookup_die $? "$vb: nothing on the screen has focus"
  IFS=$'\x1f' read -r cls enb fcb res box probe <<<"$out"
  [ "$probe" = "$after" ] || die "$vb: the field still holds text after select-all and delete"
  ok "$vb: field empty at $x,$y"; }

# ── doctor: verify/report the toolchain ──────────────────────────────────────
doctor(){
  paths; local bad=0
  say "yukti v$YUKTI_VERSION — environment check"
  if xcrun simctl help >/dev/null 2>&1; then ok "Xcode + simctl"; else die "Full Xcode required (not just CLT). Install Xcode, then: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"; fi
  xcrun simctl list runtimes 2>/dev/null | grep -qi ios && ok "iOS simulator runtime" || { warn "no iOS runtime — installing"; xcodebuild -downloadPlatform iOS; }
  command -v node >/dev/null && ok "node $(node -v)" || { warn "node@22 missing"; bad=1; echo "   brew install node@22"; }
  command -v pod  >/dev/null && ok "cocoapods $(pod --version)" || { warn "cocoapods missing"; bad=1; echo "   brew install cocoapods"; }
  command -v idb  >/dev/null && ok "idb (UI driver)" || { warn "idb missing"; bad=1; echo "   brew trust facebook/fb && brew install idb-companion && $PY -m pip install --user fb-idb"; }
  [ "$(cfg easEnabled false)" = "True" -o "$(cfg easEnabled false)" = "true" ] && { command -v npx >/dev/null && ok "npx (for EAS adapter)"; }
  [ $bad -eq 0 ] && ok "ready" || die "install the tools above, then re-run 'yukti doctor'"
}

# ── device-only-lib scan: static frameworks lacking an arm64-simulator slice ──
# (These break arm64 sim linking; exclude them from iOS autolinking for the rig.)
scan(){
  app_dir; say "scanning ios/Pods for device-only frameworks (no arm64-sim slice)…"
  find ios/Pods -type f -path "*.framework/*" ! -path "*.xcframework/*" 2>/dev/null | while read -r f; do
    file "$f" 2>/dev/null | grep -q "Mach-O" || continue
    lipo -info "$f" 2>/dev/null | grep -q arm64 || continue
    vtool -show-build "$f" 2>/dev/null | grep -qi SIMULATOR || echo "  device-only: $(echo "$f" | sed -E 's#.*/Pods/([^/]+)/.*#\1#')"
  done | sort -u
  warn "add the npm packages that vendor these to config .excludeIosAutolink[]"
}

# ── write react-native.config.js to drop device-only libs from iOS autolinking ─
write_rn_excludes(){
  app_dir; local ex; ex="$(cfg excludeIosAutolink '[]')"
  [ "$ex" = "[]" ] && return 0
  [ -f react-native.config.js ] && [ ! -f .yukti.rnconfig.bak ] && cp react-native.config.js .yukti.rnconfig.bak
  "$PY" - "$ex" > react-native.config.js <<'PY'
import json,sys
pkgs=json.loads(sys.argv[1])
deps=",\n".join(f"    {json.dumps(p)}: {{ platforms: {{ ios: null }} }}" for p in pkgs)
print("// AUTO-GENERATED by yukti — device-only libs w/o arm64-sim slice, excluded for sim builds.\n"
      "module.exports = {\n  dependencies: {\n"+deps+"\n  },\n};")
PY
  ok "react-native.config.js excludes: $(echo "$ex" | "$PY" -c 'import json,sys;print(", ".join(json.load(sys.stdin)))')"
}

# ── build a signed arm64 simulator .app for a variant ────────────────────────
build(){
  local V="${1:?usage: yukti build <variant>}"
  is_android && { build_android "$V"; return; }
  app_dir; paths
  local scheme cfgn env dd
  scheme="$(cfg variants.$V.scheme)";        [ -n "$scheme" ] || die "unknown variant '$V'"
  cfgn="$(cfg variants.$V.configuration)"
  env="$(cfg variants.$V.envFile)"
  dd="ios/.yukti-build/$V"
  say "building '$V'  (scheme='$scheme' config='$cfgn')"
  [ -n "$env" ] && [ -f "$env" ] && cp "$env" .env.local && ok "env: $env → .env.local" || warn "no envFile for '$V' (config .variants.$V.envFile)"
  write_rn_excludes
  ( cd ios && pod install >/dev/null 2>&1 ) && ok "pods installed"
  local appvar; appvar="$(cfg variants.$V.appVariant "$V")"
  NODE_ENV="$(cfg variants.$V.nodeEnv development)" APP_VARIANT="$appvar" EXPO_VARIANT_EXPLICIT=1 \
  xcodebuild -workspace "$(cfg workspace)" -scheme "$scheme" -configuration "$cfgn" \
    -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath "$dd" \
    ARCHS=arm64 ONLY_ACTIVE_ARCH=NO EXCLUDED_ARCHS=x86_64 \
    CODE_SIGN_IDENTITY="-" CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM="" PROVISIONING_PROFILE_SPECIFIER="" \
    build >/dev/null || die "xcodebuild failed — run without >/dev/null to see errors, or 'yukti scan' for device-only libs"
  # NB: ad-hoc CODE_SIGN_IDENTITY="-" keeps entitlements (keychain) so Firebase/auth works.
  #     CODE_SIGNING_ALLOWED=NO would strip them → -34018 keychain → login 401s.
  local app; app="$(find "$dd/Build/Products" -maxdepth 2 -name '*.app' | head -1)"
  [ -n "$app" ] || die "build produced no .app"
  echo "$app" > "${TMPDIR:-/tmp}/yukti-app-$V"
  ok "built: $app"
}

# ── pull an OFFICIAL simulator build from EAS (optional adapter) ──────────────
pull_eas(){
  local V="${1:?usage: yukti pull <variant>}"; app_dir; paths
  [ -f /tmp/expotoken ] || [ -n "${EXPO_TOKEN:-}" ] || die "set EXPO_TOKEN (or /tmp/expotoken) for the EAS adapter"
  local tok profile; tok="${EXPO_TOKEN:-$(cat /tmp/expotoken)}"; profile="$(cfg variants.$V.easProfile simulator)"
  say "triggering EAS simulator build (profile='$profile') — cloud, ~15 min"
  EXPO_TOKEN="$tok" npx eas-cli build --platform ios --profile "$profile" --non-interactive --wait || die "eas build failed (does eas.json have a '$profile' profile with ios.simulator=true?)"
  local url; url="$(EXPO_TOKEN="$tok" npx eas-cli build:list --platform ios --limit 1 --json --non-interactive 2>/dev/null | "$PY" -c 'import json,sys;print(json.load(sys.stdin)[0]["artifacts"]["applicationArchiveUrl"])')"
  say "downloading $url"; curl -sL "$url" -o /tmp/yukti-eas.tar.gz
  local out="ios/.yukti-build/eas-$V"; rm -rf "$out"; mkdir -p "$out"; tar -xzf /tmp/yukti-eas.tar.gz -C "$out"
  local app; app="$(find "$out" -maxdepth 2 -name '*.app' | head -1)"
  [ -n "$app" ] || die "EAS archive had no .app (was it a device .ipa? need a simulator profile)"
  echo "$app" > "${TMPDIR:-/tmp}/yukti-app-$V"; ok "pulled: $app"
}

# ── simulator lifecycle ──────────────────────────────────────────────────────
boot(){
  is_android && { boot_android; return; }
  paths; local dev rt u
  dev="$(cfg simulator.device 'iPhone 16 Pro')"
  u="$(xcrun simctl list devices | grep -m1 "$dev (" | grep -oE '[0-9A-F-]{36}' || true)"
  if [ -z "$u" ]; then
    rt="$(xcrun simctl list runtimes | grep -i ios | grep -oE 'com.apple.CoreSimulator.SimRuntime.iOS[^ ]*' | tail -1)"
    local dt; dt="$(xcrun simctl list devicetypes | grep -oE "com.apple.CoreSimulator.SimDeviceType.$(echo "$dev" | tr ' ' '-')" | head -1)"
    u="$(xcrun simctl create "yukti-$dev" "$dt" "$rt")"; ok "created $dev"
  fi
  xcrun simctl boot "$u" 2>/dev/null || true
  xcrun simctl bootstatus "$u" -b >/dev/null 2>&1 || true
  open -a Simulator
  echo "$u" > "$(udid_file)"; ok "booted $dev ($u)"
}
# The flag is read wherever it sits on the line, like `flow --check`: an option
# silently taken for the variant name is the kind of miss that ends as a run
# against the wrong build.
install(){ local V='' apk='' a
  while [ $# -gt 0 ]; do a="$1"; shift
    case "$a" in
      --apk) [ -z "$apk" ] || die "one --apk at a time - usage: yukti install [--apk <path>] <variant>"
             [ $# -gt 0 ] || die "--apk needs a path - usage: yukti install [--apk <path>] <variant>"
             apk="$1"; [ -n "$apk" ] || die "--apk needs a path - usage: yukti install [--apk <path>] <variant>"; shift;;
      --apk=*) [ -z "$apk" ] || die "one --apk at a time - usage: yukti install [--apk <path>] <variant>"
               apk="${a#--apk=}"; [ -n "$apk" ] || die "--apk needs a path - usage: yukti install [--apk <path>] <variant>";;
      -*) die "unknown option '$a' - usage: yukti install [--apk <path>] <variant>";;
      *) [ -z "$V" ] || die "one variant at a time - usage: yukti install [--apk <path>] <variant>"; V="$a";;
    esac
  done
  [ -n "$V" ] || die "usage: yukti install [--apk <path>] <variant>"
  is_android && { install_android "$V" "$apk"; return; }
  [ -z "$apk" ] || die "--apk installs an Android APK and this run is iOS - 'install' takes the .app that 'yukti build $V' or 'yukti pull $V' left"
  paths; local u app; u="$(cat "$(udid_file)")"; app="$(cat "${TMPDIR:-/tmp}/yukti-app-$V")"
  xcrun simctl install "$u" "$app" && ok "installed $(basename "$app")"; }
launch(){ local V="${1:?variant}"; is_android && { launch_android "$V"; return; }; paths; local u b; u="$(cat "$(udid_file)")"; b="$(cfg variants.$V.bundleId)"
  xcrun simctl launch "$u" "$b" && ok "launched $b"; }
# A flow inherits whatever the flow before it left behind - the session, the
# onboarding, cached content, a half-filled form. The same flow is then green
# alone and red in a suite, and nothing in the report says why. Nothing in the
# vocabulary dropped that state: `launch` on Android goes through `monkey`,
# which brings a RUNNING app to the front, and `install` uses `adb install -r`,
# which keeps the data of the previous install on purpose.
#
# Both steps take the variant name, the way `launch` does, so the package and
# the bundle id come from the config and never from the flow file.
# The platform of a step is the platform of the RUN. Asking the config for the
# variant alone is not that: a variant that names no platform of its own does
# not make the step iOS, and a config that names the platform once at the top
# level is legal - so a step reading the variant on its own would take the iOS
# path in the middle of an Android run. The run's platform is resolved once
# before the command starts, and that is what every drive primitive reads.
# Honour a variant that names its own platform, and otherwise follow the run.
step_platform(){ local V="$1" p; p="$(cfg "variants.$V.platform")"; printf '%s' "${p:-$YUKTI_PLATFORM}"; }
stop_app(){ local V="${1:-}" plat; [ -n "$V" ] || die "stopApp needs a variant name - the one used in $CONFIG"
  plat="$(step_platform "$V")"
  if [ "$plat" = android ]; then apaths; local pkg installed; pkg="$(cfg variants.$V.package)"
    [ -n "$pkg" ] || die "stopApp: variant '$V' has no 'package' in $CONFIG"
    # `am force-stop` prints nothing and exits zero for a package that is not
    # installed, exactly as for one that is. Without this probe the step reports
    # a stop that never happened every time the config carries a typo.
    installed="$(adb shell pm list packages 2>/dev/null | tr -d '\r')" || true
    # An empty list means the device did not answer, not that the app is gone:
    # without this the step blames the package name for an unreachable device
    # and sends the reader to fix the config.
    [ -n "$installed" ] || die "stopApp: could not read the package list from the device"
    case "
$installed
" in *"
package:$pkg
"*) ;; *) die "stopApp: '$pkg' is not installed on the device";; esac
    adb shell am force-stop "$pkg" || die "stopApp: force-stop failed for '$pkg'"
    ok "stopped $pkg"; return; fi
  paths; local u b; u="$(cat "$(udid_file)" 2>/dev/null)" || true
  [ -n "$u" ] || die "stopApp: no simulator recorded in $(udid_file) - run 'yukti up <variant>' first"
  b="$(cfg variants.$V.bundleId)"
  [ -n "$b" ] || die "stopApp: variant '$V' has no 'bundleId' in $CONFIG"
  # simctl refuses when the app is not running, and "not running" is the state
  # this step exists to reach: that refusal is a warning, not a failure.
  # Any refusal from simctl reads as "it was not running" here, including a
  # simulator that is not booted. The narrower form needs a Mac to write and to
  # check; the runbook names the gap rather than implying it is closed.
  xcrun simctl terminate "$u" "$b" 2>/dev/null && ok "stopped $b" || warn "stopApp: '$b' was not running (or the simulator refused)"; }
clear_state(){ local V="${1:-}" plat; [ -n "$V" ] || die "clearState needs a variant name - the one used in $CONFIG"
  plat="$(step_platform "$V")"
  [ "$plat" = android ] || die "clearState is Android-only for now - see RUNBOOK; on iOS reinstall the app between flows"
  apaths; local pkg out; pkg="$(cfg variants.$V.package)"
  [ -n "$pkg" ] || die "clearState: variant '$V' has no 'package' in $CONFIG"
  # `pm clear` says what happened in words, and its exit status does not agree
  # across platform versions: "Failed" comes back with status 1 on API 35 and
  # with status 0 elsewhere. The word is the evidence, so the step reads the
  # word, anchored at the start of the answer - stderr lands in the same string
  # and a warning that merely contains "Success" must not pass for one. `|| true`
  # is there for one reason: under `set -e` the step would otherwise die before
  # reading the answer, with no message at all.
  out="$(adb shell pm clear "$pkg" 2>&1 | tr -d '\r')" || true
  case "$out" in
    Success*) ok "cleared $pkg - the app is stopped now, launch it before the next step";;
    *) die "clearState: pm clear refused '$pkg': ${out:-no output}";;
  esac; }
# A flow could reach a screen only by walking to it: open the app, find the tab,
# find the card. Walking is the test when the test is about navigation, and pure
# cost in every other flow - and it cannot be walked back, which is why a suite
# ends up force-stopping the app between flows to get a known screen. Measured on
# one app on one Android 15 emulator, two runs each: stopApp + launch + dismiss +
# waitForId takes 34.3 and 33.7 seconds, the same screen through an address 3.7
# and 5.2 - and the address resets the scroll position of every tab, which is the
# part a tab tap does not do.
#
# What this step promises is delivery, not arrival, and the words it reports say
# so. `am start` answers "ok" for an address the app does not route - measured:
# myapp://nope-not-a-route comes back Status: ok and the app stays where it was -
# so a step that said it opened a screen would be lying for the app. Arrival is
# also later than the step: -W returns once the launch has settled, and for an
# address delivered to an app already running it returns at once, before the app
# has navigated. The step after this one therefore waits for the screen
# (waitFor / waitForId); an assert placed there races the navigation.
#
# The app is the one this run is driving, not one named in the step: the address
# is the object here, the way the variant is the object of launch and stopApp.
# Naming the package matters, and is not decoration: a device with the dev and
# the prod build side by side has two apps claiming the same scheme, and an
# unaddressed intent then opens a chooser - a flow would sit in front of it
# until it timed out, with nothing in the report about why.
#
# And the flow says WHERE, never in which environment. A scheme written into a
# step is the environment written into the test: the day the qa build and the
# prod build stop sharing one, every flow that carries an address has to be
# edited, and a flow edited for an environment is a flow that can only be run in
# that one. So the step carries a key, the config carries the base ("urlBase" on
# the variant, or one at the top level for a project whose builds share it), and
# a project that wants the paths in one place puts them there too ("urls"), so
# that a route the app renames is one line to change instead of forty.
#
# The table is all or nothing on purpose. Once a "urls" table exists, a key that
# is not in it is a typo or a route nobody wrote down - falling back to using the
# key as the path would open the address the author did not ask for and report
# success. Without a table, the key IS the path, which is the shape a project
# starts in.
url_of(){ local V="$1" key="$2" base table path
  base="$(cfg "variants.$V.urlBase")"; [ -n "$base" ] || base="$(cfg urlBase)"
  [ -n "$base" ] || die "openUrl: nothing says which address space this run is in - put \"urlBase\" on variant '$V' in $CONFIG, or one at the top level"
  table="$(cfg urls)"
  if [ -n "$table" ] && [ "$table" != "{}" ]; then
    # The key is looked up whole. The config reader walks a dotted path, and a
    # key with a dot in it would read as missing while sitting in the table in
    # plain sight - the author would then be told to add what is already there.
    path="$(printf '%s' "$table" | "$PY" -c 'import json,sys
d=json.load(sys.stdin); v=d.get(sys.argv[1], "")
print(v if isinstance(v, str) else "")' "$key")"
    [ -n "$path" ] || die "openUrl: '$key' is not in the \"urls\" table of $CONFIG - add it there, or remove the table and let the step carry the path"
  else
    path="$key"
  fi
  printf '%s%s' "$base" "$path"; }
open_url(){ local K="${1:-}" U plat V pkg out act
  [ -n "$K" ] || die "openUrl needs a destination - the key of a screen, for instance \"home\""
  V="${YUKTI_VARIANT:-}"
  [ -n "$V" ] || die "openUrl: this run does not know which app to hand '$K' to - set \$YUKTI_VARIANT to the variant in $CONFIG"
  [ -n "$(cfg "variants.$V")" ] || die "openUrl: there is no variant '$V' in $CONFIG"
  U="$(url_of "$V" "$K")" || exit 1
  plat="$(step_platform "$V")"
  if [ "$plat" = android ]; then apaths
    # The address travels through a shell on the device, where &, ; and a space
    # are punctuation. Single quotes hold all of those; a single quote inside the
    # address is the one thing they cannot hold, and guessing at it would hand the
    # device half an address. iOS takes the address as an argument and never
    # through a shell, so the refusal belongs on this side of the branch only.
    case "$U" in *"'"*) die "openUrl: the address contains a single quote, and it cannot be passed to the device shell intact: $U";; esac
    pkg="$(cfg "variants.$V.package")"
    [ -n "$pkg" ] || die "openUrl: variant '$V' has no 'package' in $CONFIG"
    # -W waits for the launch to settle and makes `am` say what happened in
    # words. The words are the evidence: `am start` exits zero on an intent it
    # could not resolve, the same as on one it delivered, so the status alone
    # would pass a typo'd scheme. `|| true` keeps `set -e` from killing the step
    # before the answer is read.
    out="$(adb shell am start -W -a android.intent.action.VIEW -d "'$U'" "$pkg" 2>&1 | tr -d '\r')" || true
    case "$out" in
      *"Error:"*) die "openUrl: the device refused '$U': $(printf '%s' "$out" | grep -m1 'Error:')";;
    esac
    # "Warning: Activity not started, intent has been delivered to currently
    # running top-most instance" is the ordinary answer for an app already in
    # front, and it is a delivery, not a refusal. "Status: ok" is what separates
    # the two, and it is printed in both cases.
    case "$out" in
      *"Status: ok"*) ;;
      *) die "openUrl: '$U' was not delivered - the device said: $(printf '%s' "${out:-nothing}" | tr '\n' ' ')";;
    esac
    # The intent named the package, so it cannot have gone elsewhere; this reads
    # back what actually took it, so that a report says which app answered.
    act="$(printf '%s' "$out" | sed -n 's/^Activity: //p' | head -1)"
    case "${act:-$pkg/}" in
      "$pkg"/*) ;;
      *) die "openUrl: '$U' was taken by $act, not by $pkg";;
    esac
    ok "delivered $U to $pkg"; return; fi
  paths; local u; u="$(cat "$(udid_file)" 2>/dev/null)" || true
  [ -n "$u" ] || die "openUrl: no simulator recorded in $(udid_file) - run 'yukti up <variant>' first"
  # simctl resolves the scheme itself and takes no bundle id, so on iOS the
  # address goes wherever the system sends it. Two builds claiming one scheme is
  # the same hazard as on Android and there is nothing here to aim with; the
  # RUNBOOK names the gap rather than implying it is closed.
  xcrun simctl openurl "$u" "$U" >/dev/null 2>&1 || die "openUrl: the simulator refused '$U'"
  ok "delivered $U"; }
up(){ local V="${1:?usage: yukti up <variant>}"; build "$V"; boot; install "$V"; launch "$V"; ok "up: '$V' running — drive with 'yukti shot' / 'yukti flow'"; }

# ── drive primitives (used by flows AND by AI agents) ────────────────────────
U(){ cat "$(udid_file)" 2>/dev/null || booted; }
idb_ready(){ paths; idb connect "$(U)" >/dev/null 2>&1 || true; }
shot(){ is_android && { ashot "$@"; return; }; paths; local o; o="$(shot_path "${1:-}")"; mkdir -p "$(dirname "$o")"; xcrun simctl io "$(U)" screenshot "$o" >/dev/null 2>&1 && echo "$o"; }
